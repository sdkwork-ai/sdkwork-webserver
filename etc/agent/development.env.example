# Web Node Daemon environment. The etc/agent path is retained for v3 compatibility.

# Control plane base URL (no trailing slash)
SDKWORK_WEBSERVER_CONTROL_PLANE_URL=http://127.0.0.1:3800

# Node bootstrap credential from POST /backend/v3/api/servers.
# The v3 response field remains agentToken until the reviewed v4 API migration.
SDKWORK_WEBSERVER_NODE_TOKEN=

# Sync interval in seconds
SDKWORK_WEBSERVER_NODE_SYNC_INTERVAL_SECS=30

# Durable desired/observed generation state.
# The default filename is now sdkwork-webserver-agent-state.json; an existing legacy
# sdkwork-web-agent-state.json file in the same directory is migrated automatically.
# SDKWORK_WEBSERVER_NODE_STATE_PATH=/var/lib/sdkwork/webserver/edge/sdkwork-webserver-agent-state.json
# SDKWORK_WEBSERVER_NODE_STATE_DIR=/var/lib/sdkwork/webserver/edge
# SDKWORK_WEBSERVER_EDGE_ROOT=/var/lib/sdkwork/webserver/edge

# Deprecated aliases: SDKWORK_WEBSERVER_AGENT_TOKEN, SDKWORK_WEBSERVER_AGENT_SYNC_INTERVAL_SECS,
# SDKWORK_WEBSERVER_AGENT_STATE_PATH, SDKWORK_WEBSERVER_AGENT_STATE_DIR. Do not set a preferred
# key and its legacy alias to different values; the daemon fails closed on conflict.

# Local nginx + certificate paths (see sdkwork-webserver-edge-runtime)
SDKWORK_WEBSERVER_NGINX_ENABLED=true
SDKWORK_WEBSERVER_NGINX_SITES_ROOT=/etc/nginx/sites-enabled/sdkwork
SDKWORK_WEBSERVER_CERT_LIVE_ROOT=/etc/sdkwork/certs/letsencrypt
