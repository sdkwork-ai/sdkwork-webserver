{
  "schemaVersion": 1,
  "kind": "sdkwork.client-env-materialization",
  "application": "sdkwork-webserver",
  "command": "pnpm workflow:materialize-client-env",
  "deploymentConfig": "sdkwork.deployment.config.json",
  "sourceIdentity": {
    "deploymentProfileKeys": [
      "SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE",
      "SDKWORK_DEPLOYMENT_PROFILE"
    ],
    "environmentKeys": [
      "SDKWORK_WEBSERVER_ENVIRONMENT",
      "SDKWORK_ENVIRONMENT"
    ],
    "profileIdKeys": [
      "SDKWORK_WEBSERVER_PROFILE_ID",
      "SDKWORK_PROFILE_ID"
    ]
  },
  "profiles": [
    "standalone.development",
    "standalone.test",
    "standalone.production",
    "standalone.staging",
    "standalone.demo"
  ],
  "surfaces": [
    {
      "id": "sdkwork-webserver-h5",
      "root": "apps/sdkwork-webserver-h5",
      "format": "vite",
      "runtimeTarget": "browser",
      "includePrefixes": [],
      "includeKeys": [],
      "bindings": {
        "VITE_SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL": {
          "sources": [
            "SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL": {
          "sources": [
            "SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL": {
          "sources": [
            "SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_WEBSERVER_ACME_DIRECTORY_URL": {
          "sources": [
            "SDKWORK_WEBSERVER_ACME_DIRECTORY_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_CORS_ALLOWED_ORIGINS": {
          "sources": [
            "SDKWORK_CORS_ALLOWED_ORIGINS"
          ],
          "required": false
        }
      },
      "constants": {
        "VITE_SDKWORK_APPLICATION_CODE": "webserver",
        "VITE_SDKWORK_SURFACE": "h5"
      },
      "requiredOutputKeys": [
        "VITE_SDKWORK_ENVIRONMENT",
        "VITE_SDKWORK_DEPLOYMENT_PROFILE",
        "VITE_SDKWORK_PROFILE_ID",
        "VITE_SDKWORK_RUNTIME_TARGET"
      ],
      "accessToken": {
        "appId": "sdkwork-webserver-h5",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "deploy.apps.read",
          "web.plugins.read",
          "web.servers.read",
          "web.auditLogs.read"
        ]
      }
    },
    {
      "id": "sdkwork-webserver-pc",
      "root": "apps/sdkwork-webserver-pc",
      "format": "vite",
      "runtimeTarget": "browser",
      "includePrefixes": [],
      "includeKeys": [],
