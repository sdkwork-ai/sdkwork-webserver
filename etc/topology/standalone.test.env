# standalone.test
# Test-environment installer profile: public ingress on 0.0.0.0:8888, host
# bound to server-test.sdkwork.com (installer writes /etc/hosts on the test host).
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=test
SDKWORK_CORS_ALLOWED_ORIGINS=https://server-test.sdkwork.com,http://server-test.sdkwork.com,https://server-test.birdcoder.com,http://server-test.birdcoder.com,https://server-test.dtupay.com,http://server-test.dtupay.com,https://server-test.noaper.com,http://server-test.noaper.com,https://server-test.sdkwork.cn,http://server-test.sdkwork.cn,https://server-test.birdcoder.cn,http://server-test.birdcoder.cn,https://server-test.dtupay.cn,http://server-test.dtupay.cn,https://server-test.noaper.cn,http://server-test.noaper.cn,https://server-test.skubc.com,http://server-test.skubc.com,https://server-test.skubc.cn,http://server-test.skubc.cn,https://server-test.zowalk.com,http://server-test.zowalk.com,https://server-test.zowalk.cn,http://server-test.zowalk.cn,https://server-test.offer86.com,http://server-test.offer86.com,https://server-test.offer86.cn,http://server-test.offer86.cn,https://server-test.86offer.com,http://server-test.86offer.com,https://server-test.86offer.cn,http://server-test.86offer.cn,https://server-app-test.sdkwork.com,http://server-app-test.sdkwork.com,https://server-app-test.birdcoder.com,http://server-app-test.birdcoder.com,https://server-app-test.dtupay.com,http://server-app-test.dtupay.com,https://server-app-test.noaper.com,http://server-app-test.noaper.com,https://server-app-test.sdkwork.cn,http://server-app-test.sdkwork.cn,https://server-app-test.birdcoder.cn,http://server-app-test.birdcoder.cn,https://server-app-test.dtupay.cn,http://server-app-test.dtupay.cn,https://server-app-test.noaper.cn,http://server-app-test.noaper.cn,https://server-app-test.skubc.com,http://server-app-test.skubc.com,https://server-app-test.skubc.cn,http://server-app-test.skubc.cn,https://server-app-test.zowalk.com,http://server-app-test.zowalk.com,https://server-app-test.zowalk.cn,http://server-app-test.zowalk.cn,https://server-app-test.offer86.com,http://server-app-test.offer86.com,https://server-app-test.offer86.cn,http://server-app-test.offer86.cn,https://server-app-test.86offer.com,http://server-app-test.86offer.com,https://server-app-test.86offer.cn,http://server-app-test.86offer.cn,https://server-admin-test.sdkwork.com,http://server-admin-test.sdkwork.com,https://server-admin-test.birdcoder.com,http://server-admin-test.birdcoder.com,https://server-admin-test.dtupay.com,http://server-admin-test.dtupay.com,https://server-admin-test.noaper.com,http://server-admin-test.noaper.com,https://server-admin-test.sdkwork.cn,http://server-admin-test.sdkwork.cn,https://server-admin-test.birdcoder.cn,http://server-admin-test.birdcoder.cn,https://server-admin-test.dtupay.cn,http://server-admin-test.dtupay.cn,https://server-admin-test.noaper.cn,http://server-admin-test.noaper.cn,https://server-admin-test.skubc.com,http://server-admin-test.skubc.com,https://server-admin-test.skubc.cn,http://server-admin-test.skubc.cn,https://server-admin-test.zowalk.com,http://server-admin-test.zowalk.com,https://server-admin-test.zowalk.cn,http://server-admin-test.zowalk.cn,https://server-admin-test.offer86.com,http://server-admin-test.offer86.com,https://server-admin-test.offer86.cn,http://server-admin-test.offer86.cn,https://server-admin-test.86offer.com,http://server-admin-test.86offer.com,https://server-admin-test.86offer.cn,http://server-admin-test.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_PROFILE_ID=standalone.test
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=test
SDKWORK_WEBSERVER_PROFILE_ID=standalone.test
SDKWORK_WEBSERVER_SNOWFLAKE_NODE_ID=0
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8888
# The application public ingress router also carries unauthenticated /healthz
# /readyz /livez /metrics, so its non-loopback bind is explicit operator
# authorization (fail-closed, see gateway main.rs). The public edge denies
# /metrics and /livez (deployments/webserver/snippets/gateway-locations.*.conf);
# scrape metrics on the host via the loopback operations listener below.
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
# Loopback-only data-plane operations listener (metrics/probes); explicit
# bind keeps the standalone profile observable like the cloud profile.
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-test.sdkwork.com:8888
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-test.sdkwork.com:8888
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-test.sdkwork.com:8888
# Installed (deb) absolute runtime roots follow RUNTIME_DIRECTORY_SPEC.md:
# private assets under /usr/lib/sdkwork/webserver, shared assets under
# /usr/share/sdkwork/webserver.
SDKWORK_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_WEBSERVER_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_WEBSERVER_SERVER_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_IAM_APP_ROOT=/usr/share/sdkwork/webserver/iam
SDKWORK_DRIVE_APP_ROOT=/usr/share/sdkwork/webserver/drive
SDKWORK_WEBSERVER_PC_STATIC_ROOT=/usr/share/sdkwork/webserver/web/pc
SDKWORK_WEBSERVER_H5_STATIC_ROOT=/usr/share/sdkwork/webserver/web/h5
SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/usr/share/sdkwork/webserver/web/static
# SDKWork Deployments same-origin dependency assembly (API_ASSEMBLY_SPEC §6.1)
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=test
SDKWORK_DEPLOY_PROFILE_ID=standalone.test
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# ACME / certificate lifecycle (worker + standalone TLS runtime distribution).
# The test environment uses the Let's Encrypt staging directory; a host-bound
# test domain cannot be validated against the production directory.
SDKWORK_WEBSERVER_ACME_PROFILE=staging
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEBSERVER_ACME_WEBROOT=/var/lib/sdkwork/webserver/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/webserver/acme-accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-0
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEBSERVER_NODE_UUID=standalone-test-node
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=/var/lib/sdkwork/webserver/tls-materials
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/webserver/tls-materials/tls-runtime.json
SDKWORK_WEBSERVER_TLS_SNAPSHOT_ALPN=h2,http/1.1

