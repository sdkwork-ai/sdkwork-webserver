# standalone.development
# Browser opens one Adaptive Web origin: WEB_DEV_INGRESS_BIND (device → PC/H5).
# PC/H5 INTERNAL_DEV_PORT are private Vite renderers only — not browser URLs.
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5182
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_SNOWFLAKE_NODE_ID=0
SDKWORK_WEBSERVER_WEB_DEV_INGRESS_BIND=127.0.0.1:5182
# Private Vite renderer ports behind the adaptive ingress (not browser-facing).
SDKWORK_WEBSERVER_PC_INTERNAL_DEV_PORT=5184
SDKWORK_WEBSERVER_H5_INTERNAL_DEV_PORT=5185
# Built SPA roots follow the standard dist/{standalone,cloud}/{environment} layout
# (FRONTEND_CODE_SPEC §7 / SDKWORK_DEPLOY_SPEC §8); the gateway app shell
# serves the dev build directly on the management origin.
SDKWORK_WEBSERVER_PC_STATIC_ROOT=./apps/sdkwork-webserver-pc/dist/standalone/dev
SDKWORK_WEBSERVER_H5_STATIC_ROOT=./apps/sdkwork-webserver-h5/dist/standalone/dev
SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=./deployments/webserver/static
# SDKWORK_WEBSERVER_TABLET_SURFACE=pc
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3800
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3800
SDKWORK_IAM_APP_ROOT=../sdkwork-iam
SDKWORK_DRIVE_APP_ROOT=../sdkwork-drive
# SDKWork Deployments same-origin dependency assembly (API_ASSEMBLY_SPEC §6.1):
# the Deployments service host and domain/certificate blocks run inside this
# gateway process; cloud profiles keep the external deploy-app URL instead.
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_PROFILE_ID=standalone.development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# ACME / certificate lifecycle (worker + standalone TLS runtime distribution)
SDKWORK_WEBSERVER_ACME_PROFILE=staging
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEBSERVER_ACME_WEBROOT=./target/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=./target/certs/accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-dev-1
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEBSERVER_NODE_UUID=development-node
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=./target/tls-materials
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=./target/tls-materials/tls-runtime.json
SDKWORK_WEBSERVER_TLS_SNAPSHOT_ALPN=h2,http/1.1

