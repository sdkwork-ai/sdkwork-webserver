# cloud.production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://server.sdkwork.com
SDKWORK_PROFILE_ID=cloud.production
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=cloud
SDKWORK_WEBSERVER_ENVIRONMENT=production
SDKWORK_WEBSERVER_PROFILE_ID=cloud.production
SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=https://server.sdkwork.com
VITE_SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=https://server-app.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=https://server-admin.sdkwork.com
SDKWORK_WEBSERVER_SERVER_CONFIG_FILE=/etc/sdkwork/webserver/sdkwork.webserver.config.json
SDKWORK_WEBSERVER_RUNTIME_ASSIGNMENT_SOURCE=cloud
SDKWORK_WEBSERVER_INTERNAL_API_BASE_URL=https://server.sdkwork.com
SDKWORK_WEBSERVER_NODE_TOKEN_FILE=/run/secrets/sdkwork-web-node-token
SDKWORK_WEBSERVER_NODE_UUID=
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_ENVIRONMENT=production
SDKWORK_WEBSERVER_NODE_VERSION=0.1.0
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_RECOVERY_DIRECTORY=/var/lib/sdkwork/webserver/website-runtime-recovery
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_POLL_INTERVAL_MS=2000
SDKWORK_WEBSERVER_TLS_RUNTIME_SOURCE=external
SDKWORK_WEBSERVER_WEBSITE_TENANT_SCOPE_HASH=
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_VALIDATION_CONCURRENCY=16
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_EVENT_CONFIG_FILE=/etc/sdkwork/webserver/website-provider-events.json
SDKWORK_WEBSERVER_DRIVE_INTERNAL_API_BASE_URL=https://drive-internal.sdkwork.com
SDKWORK_WEBSERVER_DRIVE_INTERNAL_API_INGRESS_TOKEN_FILE=/run/secrets/sdkwork-drive-ingress-token
SDKWORK_WEBSERVER_KNOWLEDGEBASE_INTERNAL_API_BASE_URL=https://knowledgebase.sdkwork.com
SDKWORK_WEBSERVER_KNOWLEDGEBASE_INTERNAL_API_INGRESS_TOKEN_FILE=/run/secrets/sdkwork-knowledgebase-ingress-token
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
