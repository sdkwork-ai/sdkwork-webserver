# cloud.development
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5182
SDKWORK_PROFILE_ID=cloud.development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=cloud
SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_PROFILE_ID=cloud.development
# Single browser-visible Adaptive Web ingress (device class selects PC/H5).
SDKWORK_WEBSERVER_WEB_DEV_INGRESS_BIND=127.0.0.1:5182
# Private Vite renderer ports behind the adaptive ingress (not browser-facing).
SDKWORK_WEBSERVER_PC_INTERNAL_DEV_PORT=5184
SDKWORK_WEBSERVER_H5_INTERNAL_DEV_PORT=5185
SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=https://server-dev.sdkwork.com
VITE_SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=https://server-app-dev.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=https://server-admin-dev.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
