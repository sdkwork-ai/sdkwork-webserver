# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment uses its own dedicated PostgreSQL schema/user `sdkwork_webserver_demo`
# and a dedicated Redis logical DB index (see SDKWORK_WEBSERVER_REDIS_URL below when Redis is
# enabled) so no cache key (rate-limit, session, proxy-buffer, ACME) ever collides with another
# shared-redis environment. The webserver gateway itself owns no persistence; dependent module
# sidecars (iam/drive/deploy/skills) keep their own `*_demo` schema and `-demo` redis prefix.
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CORS_ALLOWED_ORIGINS=http://server-demo.sdkwork.com:18073,https://server-demo.sdkwork.com,http://server-demo.sdkwork.com,https://server-demo.birdcoder.com,http://server-demo.birdcoder.com,https://server-demo.dtupay.com,http://server-demo.dtupay.com,https://server-demo.noaper.com,http://server-demo.noaper.com,https://server-demo.sdkwork.cn,http://server-demo.sdkwork.cn,https://server-demo.birdcoder.cn,http://server-demo.birdcoder.cn,https://server-demo.dtupay.cn,http://server-demo.dtupay.cn,https://server-demo.noaper.cn,http://server-demo.noaper.cn,https://server-demo.skubc.com,http://server-demo.skubc.com,https://server-demo.skubc.cn,http://server-demo.skubc.cn,https://server-demo.zowalk.com,http://server-demo.zowalk.com,https://server-demo.zowalk.cn,http://server-demo.zowalk.cn,https://server-demo.offer86.com,http://server-demo.offer86.com,https://server-demo.offer86.cn,http://server-demo.offer86.cn,https://server-demo.86offer.com,http://server-demo.86offer.com,https://server-demo.86offer.cn,http://server-demo.86offer.cn,https://server-app-demo.sdkwork.com,http://server-app-demo.sdkwork.com,https://server-app-demo.birdcoder.com,http://server-app-demo.birdcoder.com,https://server-app-demo.dtupay.com,http://server-app-demo.dtupay.com,https://server-app-demo.noaper.com,http://server-app-demo.noaper.com,https://server-app-demo.sdkwork.cn,http://server-app-demo.sdkwork.cn,https://server-app-demo.birdcoder.cn,http://server-app-demo.birdcoder.cn,https://server-app-demo.dtupay.cn,http://server-app-demo.dtupay.cn,https://server-app-demo.noaper.cn,http://server-app-demo.noaper.cn,https://server-app-demo.skubc.com,http://server-app-demo.skubc.com,https://server-app-demo.skubc.cn,http://server-app-demo.skubc.cn,https://server-app-demo.zowalk.com,http://server-app-demo.zowalk.com,https://server-app-demo.zowalk.cn,http://server-app-demo.zowalk.cn,https://server-app-demo.offer86.com,http://server-app-demo.offer86.com,https://server-app-demo.offer86.cn,http://server-app-demo.offer86.cn,https://server-app-demo.86offer.com,http://server-app-demo.86offer.com,https://server-app-demo.86offer.cn,http://server-app-demo.86offer.cn,https://server-admin-demo.sdkwork.com,http://server-admin-demo.sdkwork.com,https://server-admin-demo.birdcoder.com,http://server-admin-demo.birdcoder.com,https://server-admin-demo.dtupay.com,http://server-admin-demo.dtupay.com,https://server-admin-demo.noaper.com,http://server-admin-demo.noaper.com,https://server-admin-demo.sdkwork.cn,http://server-admin-demo.sdkwork.cn,https://server-admin-demo.birdcoder.cn,http://server-admin-demo.birdcoder.cn,https://server-admin-demo.dtupay.cn,http://server-admin-demo.dtupay.cn,https://server-admin-demo.noaper.cn,http://server-admin-demo.noaper.cn,https://server-admin-demo.skubc.com,http://server-admin-demo.skubc.com,https://server-admin-demo.skubc.cn,http://server-admin-demo.skubc.cn,https://server-admin-demo.zowalk.com,http://server-admin-demo.zowalk.com,https://server-admin-demo.zowalk.cn,http://server-admin-demo.zowalk.cn,https://server-admin-demo.offer86.com,http://server-admin-demo.offer86.com,https://server-admin-demo.offer86.cn,http://server-admin-demo.offer86.cn,https://server-admin-demo.86offer.com,http://server-admin-demo.86offer.com,https://server-admin-demo.86offer.cn,http://server-admin-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_PROFILE_ID=standalone.demo
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=demo
SDKWORK_WEBSERVER_PROFILE_ID=standalone.demo
SDKWORK_WEBSERVER_SNOWFLAKE_NODE_ID=0
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18073
# The application public ingress router also carries unauthenticated /healthz
# /readyz /livez /metrics, so its non-loopback bind is explicit operator
# authorization (fail-closed, see gateway main.rs). The public edge denies
# /metrics and /livez (deployments/webserver/snippets/gateway-locations.*.conf);
# scrape metrics on the host via the loopback operations listener below.
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
# Loopback-only data-plane operations listener (metrics/probes); explicit
# bind keeps the standalone profile observable like the cloud profile.
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-demo.sdkwork.com:18073
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-demo.sdkwork.com:18073
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-demo.sdkwork.com:18073
# Installed (deb) absolute runtime roots follow RUNTIME_DIRECTORY_SPEC.md:
# private assets under /usr/lib/sdkwork/webserver, shared assets under
# /usr/share/sdkwork/webserver.
SDKWORK_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_WEBSERVER_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_WEBSERVER_SERVER_APP_ROOT=/usr/lib/sdkwork/webserver
SDKWORK_IAM_APP_ROOT=/usr/share/sdkwork/webserver/iam
SDKWORK_DRIVE_APP_ROOT=/usr/share/sdkwork/webserver/drive
SDKWORK_WEBSERVER_PC_STATIC_ROOT=/usr/share/sdkwork/webserver/web/pc
SDKWORK_WEBSERVER_H5_STATIC_ROOT=/usr/share/sdkwork/webserver/web/h5
SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/usr/share/sdkwork/webserver/web/static
# SDKWork Deployments same-origin dependency assembly (API_ASSEMBLY_SPEC §6.1)
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=demo
SDKWORK_DEPLOY_PROFILE_ID=standalone.demo
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# ACME / certificate lifecycle (worker + standalone TLS runtime distribution).
# The demo environment uses the Let's Encrypt staging directory; a demo-bound
# domain cannot be validated against the production directory.
SDKWORK_WEBSERVER_ACME_PROFILE=staging
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEBSERVER_ACME_WEBROOT=/var/lib/sdkwork/webserver/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/webserver/acme-accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-0
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEBSERVER_NODE_UUID=standalone-demo-node
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=/var/lib/sdkwork/webserver/tls-materials
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/webserver/tls-materials/tls-runtime.json
SDKWORK_WEBSERVER_TLS_SNAPSHOT_ALPN=h2,http/1.1
