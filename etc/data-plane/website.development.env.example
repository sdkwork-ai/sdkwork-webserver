SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_RUNTIME_TARGET=server
SDKWORK_WEBSERVER_SERVER_CONFIG_FILE=etc/examples/sdkwork.webserver.config.json
SDKWORK_WEBSERVER_RUNTIME_ASSIGNMENT_SOURCE=file
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_FILE=.sdkwork/runtime/website-runtime-set.json
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_RECOVERY_DIRECTORY=.sdkwork/runtime/website-runtime-recovery
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_POLL_INTERVAL_MS=2000
SDKWORK_WEBSERVER_TLS_RUNTIME_SOURCE=external
SDKWORK_WEBSERVER_WEBSITE_TENANT_SCOPE_HASH=1111111111111111111111111111111111111111111111111111111111111111
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_VALIDATION_CONCURRENCY=16
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_BUFFERED_CONTENT_BYTES=268435456
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_RESOLUTION_CACHE_ENTRIES=16384
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_EVENT_CONFIG_FILE=etc/data-plane/website-provider-events.development.json.example
# Split deployment: this file runs only the website data plane, so the sibling
# modules are reached over their Internal APIs (MODULE_SPEC.md 4.2.3). The
# in-process transport is the default in the integrated gateway.
SDKWORK_WEBSERVER_DRIVE_PROVIDER_MODE=http
SDKWORK_WEBSERVER_KNOWLEDGEBASE_PROVIDER_MODE=http
SDKWORK_WEBSERVER_DRIVE_INTERNAL_API_BASE_URL=http://127.0.0.1:3900
SDKWORK_WEBSERVER_DRIVE_INTERNAL_API_INGRESS_TOKEN_FILE=.sdkwork/secrets/drive-ingress-token
SDKWORK_WEBSERVER_KNOWLEDGEBASE_INTERNAL_API_BASE_URL=http://127.0.0.1:3801
SDKWORK_WEBSERVER_KNOWLEDGEBASE_INTERNAL_API_INGRESS_TOKEN_FILE=.sdkwork/secrets/knowledgebase-ingress-token
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901
