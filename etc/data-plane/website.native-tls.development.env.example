SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_RUNTIME_TARGET=server
SDKWORK_WEBSERVER_SERVER_CONFIG_FILE=etc/data-plane/website.native-tls.config.json
SDKWORK_WEBSERVER_RUNTIME_ASSIGNMENT_SOURCE=file
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_FILE=.sdkwork/runtime/website-runtime-set.json
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_RECOVERY_DIRECTORY=.sdkwork/runtime/website-runtime-recovery
SDKWORK_WEBSERVER_WEBSITE_RUNTIME_SET_POLL_INTERVAL_MS=2000
SDKWORK_WEBSERVER_WEBSITE_TENANT_SCOPE_HASH=1111111111111111111111111111111111111111111111111111111111111111
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_VALIDATION_CONCURRENCY=16
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_BUFFERED_CONTENT_BYTES=268435456
SDKWORK_WEBSERVER_WEBSITE_PROVIDER_RESOLUTION_CACHE_ENTRIES=16384
SDKWORK_WEBSERVER_TLS_RUNTIME_SOURCE=file
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=.sdkwork/runtime/tls-runtime.json
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=.sdkwork/secrets/tls-materials
SDKWORK_WEBSERVER_TLS_LISTENER_ID=website-https
SDKWORK_WEBSERVER_TLS_RUNTIME_POLL_INTERVAL_MS=2000
SDKWORK_WEBSERVER_TLS_RUNTIME_RECOVERY_DIRECTORY=.sdkwork/runtime/tls-runtime-recovery
# Optional Drive certificate authority source (highest SNI priority). The root
# holds one directory per bundle; the leaf SAN names decide which names it
# serves. The disk cache must outlive the Drive mount, so it is configured
# outside the root.
SDKWORK_WEBSERVER_DRIVE_CERTIFICATE_ROOT=.sdkwork/runtime/drive-certificates
SDKWORK_WEBSERVER_DRIVE_CERTIFICATE_CACHE_ROOT=.sdkwork/secrets/drive-certificate-cache
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901
