{
  "schemaVersion": 1,
  "kind": "sdkwork.webserver.app",
  "appKey": "sdkwork-website-delivery",
  "nginx": {
    "profile": "http-core-v1",
    "unknownDirectivePolicy": "error"
  },
  "listeners": [
    {
      "id": "website-http",
      "bind": "0.0.0.0",
      "port": 8080,
      "protocols": [
        "http1"
      ],
      "defaultVirtualHostRef": "website-delivery",
      "allowPlaintextHttp": true
    }
  ],
  "certificates": [],
  "tlsPolicies": [],
  "resolvers": [],
  "resources": [
    {
      "id": "unmatched-response",
      "type": "respond",
      "status": 404,
      "contentType": "text/plain; charset=utf-8",
      "body": "not found\n"
    }
  ],
  "upstreams": [],
  "virtualHosts": [
    {
      "id": "website-delivery",
      "listenerRefs": [
        "website-http"
      ],
      "serverNames": [
        "localhost"
      ],
      "routes": [
        {
          "id": "unmatched",
          "match": {
            "pathType": "prefix",
            "path": "/"
          },
          "resourceRef": "unmatched-response"
        }
      ]
    }
  ],
  "observability": {
    "accessLog": true
  },
  "deployment": {
    "drainTimeoutMs": 30000,
    "reload": {
      "mode": "disabled",
      "pollIntervalMs": 1000
    },
    "resourcePressure": {
      "sampleIntervalMs": 250,
      "maximumProcessMemoryBytes": 1073741824,
      "memoryReserveBytes": 67108864,
      "memoryAdmissionPercent": 90,
      "memoryRecoveryPercent": 80,
      "maximumOpenHandles": 16384,
      "openHandleReserve": 128,
      "openHandleAdmissionPercent": 90,
      "openHandleRecoveryPercent": 80,
      "eventLoopLagAdmissionMs": 250,
      "eventLoopLagRecoveryMs": 50,
      "consecutivePressureSamples": 2,
      "consecutiveRecoverySamples": 4,
      "operationsReserveRequests": 16,
      "sampleFailurePolicy": "fail-closed"
    }
  },
  "metadata": {
    "owner": "sdkwork",
    "purpose": "cloud-website-delivery"
  },
  "appDomainFallback": {
    "enabled": true,
    "suffixes": [
      "sdkwork.com",
      "sdkwork.cn",
      "birdcoder.com",
      "birdcoder.cn",
      "dtupay.com",
      "dtupay.cn",
      "skubc.com",
      "skubc.cn",
      "zowalk.com",
      "zowalk.cn",
      "offer86.com",
      "offer86.cn",
      "86offer.com",
      "86offer.cn"
    ],
    "lookup": {
      "mode": "embedded"
    },
    "timeoutMs": 2000,
    "cacheTtlMs": 60000,
    "negativeCacheTtlMs": 5000
  },
  "usageMetering": {
    "enabled": true,
    "windowSeconds": 60,
    "flushIntervalMs": 30000,
    "channel": {
      "mode": "embedded"
    }
  }
}
