{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-api-webserver-assembly",
    "displayName": "SDKWork web-server Gateway Assembly",
    "version": "0.1.0",
    "type": "rust-api-assembly",
    "root": "crates/sdkwork-api-webserver-assembly",
    "domain": "application",
    "capability": "api-assembly",
    "surface": "api-assembly",
    "languages": [
      "rust"
    ],
    "generated": false,
    "manifests": [
      "Cargo.toml",
      "assembly-manifest.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "APPLICATION_GATEWAY_SPEC.md",
      "path": "../../../sdkwork-specs/APPLICATION_GATEWAY_SPEC.md",
      "purpose": "Gateway assembly discovery, business-only mounting, and verification rules."
    },
    {
      "file": "WEB_FRAMEWORK_SPEC.md",
      "path": "../../../sdkwork-specs/WEB_FRAMEWORK_SPEC.md",
      "purpose": "Typed request context and HTTP framework composition rules."
    },
    {
      "file": "DATABASE_FRAMEWORK_SPEC.md",
      "path": "../../../sdkwork-specs/DATABASE_FRAMEWORK_SPEC.md",
      "purpose": "Database lifecycle bootstrap ownership for embedded assemblies."
    }
  ],
  "contracts": {
    "layerRole": "runtime-composition",
    "publicExports": [
      "sdkwork_api_webserver_assembly::assemble_api_router",
      "sdkwork_api_webserver_assembly::migrate_database_from_env",
      "sdkwork_api_webserver_assembly::ApiAssembly",
      "sdkwork_api_webserver_assembly::ApiAssembly::into_contribution",
      "sdkwork_api_webserver_assembly::ApiAssemblyContext",
      "sdkwork_api_webserver_assembly::ApiAssemblyError"
    ],
    "providedPorts": [
      {"name": "webServerApiAssembly", "export": "sdkwork_api_webserver_assembly::assemble_api_router"},
      {"name": "webServerDatabaseMigration", "export": "sdkwork_api_webserver_assembly::migrate_database_from_env"}
    ],
    "requiredPorts": [
      {"name": "webServerRepositoryRuntime", "export": "crate-root", "provider": "sdkwork-intelligence-webserver-repository-sqlx"},
      {"name": "webServerDatabaseLifecycle", "export": "crate-root", "provider": "sdkwork-webserver-database-host"},
      {"name": "skillsDatabaseLifecycle", "export": "sdkwork_api_skills_assembly::bootstrap_database_from_env", "provider": "sdkwork-api-skills-assembly"},
      {"name": "mcpDatabaseLifecycle", "export": "sdkwork_api_mcp_assembly::bootstrap_database_from_env", "provider": "sdkwork-api-mcp-assembly"}
    ],
    "runtimeEntrypoints": [],
    "routeManifest": "assembly-manifest.json",
    "sdkClients": [],
    "sdkDependencies": [],
    "dependencyApiExports": [],
    "dependencyApiSurfaces": [],
    "events": [],
    "configKeys": []
  },
  "verification": {
    "commands": [
      "pnpm run api:assembly:validate",
      "cargo check -p sdkwork-api-webserver-assembly"
    ]
  }
}
