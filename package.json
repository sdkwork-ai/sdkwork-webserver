{
  "name": "sdkwork-web-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "tar": "7.5.21",
    "sigstore": "4.1.1",
    "yaml": "^2.8.0",
    "@sdkwork/app-topology": "workspace:*",
    "@sdkwork/iam-application-bootstrap": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "vitepress>vite": "6.4.3",
      "@sdkwork/sdk-common": "workspace:*"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@docsearch/react>@types/react": "19",
        "@docsearch/react>react": "19",
        "@docsearch/react>react-dom": "19"
      }
    }
  },
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
    "dev:server": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
    "dev:server:postgres": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
    "dev:server:postgres:standalone": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
    "stop": "pnpm exec sdkwork-app stop",
    "build": "pnpm exec sdkwork-app build",
    "release:plan:standalone": "pnpm exec sdkwork-app release:plan --deployment-profile standalone",
    "release:plan:cloud": "pnpm exec sdkwork-app release:plan --deployment-profile cloud",
    "release:build:standalone": "pnpm exec sdkwork-app release:build --deployment-profile standalone",
    "release:build:cloud": "pnpm exec sdkwork-app release:build --deployment-profile cloud",
    "release:package:standalone": "pnpm exec sdkwork-app release:package --deployment-profile standalone",
    "release:package:cloud": "pnpm exec sdkwork-app release:package --deployment-profile cloud",
    "release:validate:standalone": "pnpm exec sdkwork-app release:validate --deployment-profile standalone",
    "release:validate:cloud": "pnpm exec sdkwork-app release:validate --deployment-profile cloud",
    "release:smoke:standalone": "node scripts/webserver-release-smoke.mjs --deployment-profile standalone",
    "release:smoke:cloud": "node scripts/webserver-release-smoke.mjs --deployment-profile cloud",
    "release:deb:test": "node scripts/webserver-deb.mjs package --environment test",
    "release:deb:production": "node scripts/webserver-deb.mjs package --environment production",
    "release:deb:validate:test": "node scripts/webserver-deb.mjs validate --environment test",
    "release:deb:validate:production": "node scripts/webserver-deb.mjs validate --environment production",
    "docker:build:standalone": "node scripts/docker/build-standalone-image.mjs",
    "docker:up:development": "node scripts/docker/compose.mjs up --environment development",
    "docker:up:development:external": "node scripts/docker/compose.mjs up --environment development --external",
    "docker:up:test": "node scripts/docker/compose.mjs up --environment test",
    "docker:up:test:external": "node scripts/docker/compose.mjs up --environment test --external",
    "docker:up:production": "node scripts/docker/compose.mjs up --environment production",
    "docker:up:production:external": "node scripts/docker/compose.mjs up --environment production --external",
    "docker:down:development": "node scripts/docker/compose.mjs down --environment development",
    "docker:down:development:external": "node scripts/docker/compose.mjs down --environment development --external",
    "docker:down:test": "node scripts/docker/compose.mjs down --environment test",
    "docker:down:test:external": "node scripts/docker/compose.mjs down --environment test --external",
    "docker:down:production": "node scripts/docker/compose.mjs down --environment production",
    "docker:down:production:external": "node scripts/docker/compose.mjs down --environment production --external",
    "docker:up:all:shared": "node scripts/docker/compose.mjs up --environment all --shared",
    "docker:down:all:shared": "node scripts/docker/compose.mjs down --environment all --shared",
    "deploy:apply:standalone": "bash scripts/docker/deploy-docker-environment.sh",
    "check:container-deployment": "node scripts/docker/validate-docker-deployment.mjs --matrix",
    "check:webserver-toml": "node ../sdkwork-specs/tools/check-webserver-toml-standard.mjs --root .",
    "check:webserver-toml:all": "node tools/validate-all-webserver-toml.mjs",
    "nginx:normalize-toml": "node tools/normalize-nginx-toml-table.mjs",
    "test:webserver-toml": "node --test ../sdkwork-specs/tools/check-webserver-toml-standard.test.mjs ../sdkwork-specs/tools/retired-nginx.test.mjs",
    "check:nginx-gap": "node --test tools/check-nginx-gap.mjs",
    "check:nginx-corpus": "node --test tools/check-nginx-behavioral-corpus.mjs",
    "nginx:import:classify": "node tools/import-nginx-conf.mjs",
    "nginx:import:draft": "node tools/import-nginx-conf.mjs --write-draft .sdkwork/runtime/nginx-import.draft.json",
    "nginx:import:toml": "node tools/import-nginx-conf.mjs --write-draft .sdkwork/runtime/nginx-import.draft.json --write-toml .sdkwork/runtime/nginx-import.server.toml",
    "test:nginx-import": "node --test tools/import-nginx-conf.test.mjs",
    "check:adaptive-web": "node ../sdkwork-specs/tools/check-adaptive-web-standard.mjs --root .",
    "check:browser-dist-layout": "node ../sdkwork-specs/tools/check-browser-dist-layout.mjs --root .",
    "check:deploy": "node ../sdkwork-specs/tools/check-deploy-standard.mjs --root .",
    "check:deploy-layout": "node ../sdkwork-specs/tools/check-application-deploy-layout.mjs --root .",
    "nginx:render": "node scripts/render-webserver-nginx-sidecars.mjs",
    "test:container-deployment": "node --test scripts/docker/deployment-contract.test.mjs",
    "release:rpm:test": "node scripts/webserver-rpm.mjs package --environment test",
    "release:rpm:production": "node scripts/webserver-rpm.mjs package --environment production",
    "release:rpm:validate:test": "node scripts/webserver-rpm.mjs validate --environment test",
    "release:rpm:validate:production": "node scripts/webserver-rpm.mjs validate --environment production",
    "test": "pnpm exec sdkwork-app test",
    "test:database:recovery": "node scripts/database-recovery-verify.mjs",
    "test:postgres:ha": "node scripts/postgres-ha-verify.mjs",
    "test:postgres:required": "node scripts/postgres-ci-verify.mjs",
    "test:contracts": "node --test tests/contract/*.contract.test.mjs",
    "test:contract:iam-application-bootstrap": "node --test scripts/dev/sdkwork-webserver-iam-application-bootstrap-standard.test.mjs",
    "admin:bootstrap:app": "node ../sdkwork-iam/scripts/bootstrap/bootstrap-app.mjs --config sdkwork.app.config.json",
    "check": "pnpm exec sdkwork-app check",
    "check:iam-application-bootstrap": "node ../sdkwork-specs/tools/check-iam-application-bootstrap-standard.mjs --root . && pnpm test:contract:iam-application-bootstrap",
    "check:api-envelope": "node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
    "check:api-operation-patterns": "node ../sdkwork-specs/tools/check-api-operation-patterns.mjs --root .",
    "check:repository-docs": "node ../sdkwork-specs/tools/check-repository-docs-standard.mjs --root .",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix web",
    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "api:materialize": "node tools/materialize_web_phase1_contracts.mjs",
    "api:materialize:check": "node tools/materialize_web_phase1_contracts.mjs --check",
    "api:check": "pnpm api:materialize:check && pnpm check:api-envelope && pnpm check:api-operation-patterns && pnpm api:assembly:validate",
    "sdk:generate": "pnpm api:materialize && node tools/generate_web_sdks.mjs",
    "sdk:generate:check": "pnpm api:materialize:check && node tools/generate_web_sdks.mjs --check && node ../sdkwork-specs/tools/check-sdk-standard.mjs --workspace .",
    "sdk:check": "pnpm sdk:generate:check",
    "sdk:generate:app": "node tools/generate_web_sdks.mjs --family sdkwork-web-app-sdk",
    "sdk:generate:backend": "node tools/generate_web_sdks.mjs --family sdkwork-web-backend-sdk",
    "sdk:generate:internal": "node tools/generate_web_sdks.mjs --family sdkwork-web-internal-sdk",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_web_baseline.sql --module-id web --owner web-platform --prefixes web_ --engines postgres",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:migrate": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode migrate --config .env.postgres --app-root .",
    "db:test:postgres": "cargo test -p sdkwork-webserver-database-host --test postgres_lifecycle -- --ignored",
    "gateway:run:standalone": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
    "gateway:plan:standalone": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone --dry-run",
    "gateway:build:standalone": "node scripts/build.mjs --package sdkwork-api-webserver-standalone-gateway --bin sdkwork-api-webserver-standalone-gateway",
    "gateway:package:standalone": "node scripts/build.mjs --release --package sdkwork-api-webserver-standalone-gateway --bin sdkwork-api-webserver-standalone-gateway",
    "gateway:validate:standalone": "node scripts/build.mjs --check --package sdkwork-api-webserver-standalone-gateway --bin sdkwork-api-webserver-standalone-gateway",
    "gateway:matrix": "pnpm gateway:matrix:standalone",
    "gateway:matrix:standalone": "pnpm exec sdkwork-app release:plan --deployment-profile standalone --runtime-target server",
    "gateway:route-composition:audit": "node ../sdkwork-specs/tools/audit-gateway-route-composition-workspace.mjs --workspace .. --prefix sdkwork-webserver",
    "topology:validate": "pnpm exec sdkwork-app topology:validate",
    "topology:plan": "pnpm exec sdkwork-app topology:plan",
    "deploy:validate": "pnpm exec sdkwork-app deploy:validate",
    "deploy:validate:standalone": "pnpm exec sdkwork-app deploy:validate --profile standalone.production",
    "deploy:validate:cloud": "pnpm exec sdkwork-app deploy:validate --profile cloud.production",
    "deploy:plan:standalone": "pnpm exec sdkwork-app deploy:plan --profile standalone.production",
    "deploy:plan:cloud": "pnpm exec sdkwork-app deploy:plan --profile cloud.production",
    "deploy:apply:standalone": "pnpm exec sdkwork-app deploy:apply --profile standalone.production --environment production",
    "deploy:apply:cloud": "pnpm exec sdkwork-app deploy:apply --profile cloud.production --environment production",
    "deploy:rollback:standalone": "pnpm exec sdkwork-app deploy:rollback --profile standalone.production --environment production",
    "deploy:rollback:cloud": "pnpm exec sdkwork-app deploy:rollback --profile cloud.production --environment production",
    "sbom:generate": "node scripts/webserver-sbom.mjs generate",
    "sbom:check": "node scripts/webserver-sbom.mjs validate",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "_sdkwork:gateway:standalone": "node scripts/webserver-dev.mjs --database postgres --deployment-profile standalone --environment development",
    "_sdkwork:runtime:website-data-plane": "cargo run -p sdkwork-webserver-website-delivery-edge-runtime --",
    "_sdkwork:build": "node scripts/build.mjs --release",
    "_sdkwork:test": "cargo test --workspace && pnpm test:contracts && pnpm test:contract:iam-application-bootstrap",
    "_sdkwork:check": "pnpm run check:app-composition && pnpm check:iam-application-bootstrap && pnpm api:check && pnpm sdk:check && pnpm check:repository-docs && pnpm check:pnpm-script-standard && pnpm check:agent-workflow-standard && pnpm topology:validate && pnpm db:validate && pnpm deploy:validate && pnpm --dir apps/sdkwork-webserver-pc check && pnpm --dir apps/sdkwork-webserver-h5 check",
    "_sdkwork:verify": "cargo fmt -- --check && pnpm run _sdkwork:test && pnpm api:materialize:check && pnpm check && pnpm exec sdkwork-app dev --deployment-profile cloud --dry-run",
    "_sdkwork:clean": "node scripts/clean.mjs",
    "_sdkwork:release:package:standalone": "node scripts/webserver-release.mjs package --deployment-profile standalone",
    "_sdkwork:release:package:cloud": "node scripts/webserver-release.mjs package --deployment-profile cloud",
    "_sdkwork:release:validate:standalone": "node scripts/webserver-release.mjs validate --deployment-profile standalone",
    "_sdkwork:release:validate:cloud": "node scripts/webserver-release.mjs validate --deployment-profile cloud"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
