# Resolve sibling SDKWork package ranges to this workspace's checkouts first (the
# deployments app SDK declares `@sdkwork/drive-app-sdk`: `"^0.1.1"` for its npm
# consumers; inside this workspace that range must link the checkout copy, or a
# second drive SDK instance enters the program and its uploader types collide
# with the checkout types every bridged page is compiled against).
link-workspace-packages=true
prefer-workspace-packages=true
