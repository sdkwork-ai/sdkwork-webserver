    "schemas": {
      "Int64String": {
        "type": "string",
        "format": "int64",
        "pattern": "^[0-9]+$",
        "x-sdkwork-int64-string": true
      },
      "ClusterRegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "instance"
        ],
        "properties": {
          "clusterCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Target cluster code; omitted registers into the auto-provisioned default cluster."
          },
          "host": {
            "$ref": "#/components/schemas/ClusterHostDescriptor"
          },
          "instance": {
            "$ref": "#/components/schemas/ClusterInstanceDescriptor"
          }
        }
      },
      "ClusterHostDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostname",
          "machineCode"
        ],
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "machineCode": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Stable hardware/machine fingerprint of the host."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "osName": {
            "type": "string",
            "maxLength": 100
