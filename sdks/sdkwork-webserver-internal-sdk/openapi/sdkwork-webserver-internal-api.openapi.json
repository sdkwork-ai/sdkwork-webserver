  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Rotatable application-ingress service or Web Node credential."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "NodeUuid": {
        "name": "nodeUuid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        }
      },
      "Environment": {
        "name": "environment",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RuntimeEnvironment"
        }
      },
      "EnvironmentQuery": {
        "name": "environment",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RuntimeEnvironment"
