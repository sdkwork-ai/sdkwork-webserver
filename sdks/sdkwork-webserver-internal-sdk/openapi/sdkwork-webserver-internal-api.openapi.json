    "/internal/v3/api/web/cluster/instances/register": {
      "post": {
        "operationId": "cluster.instances.register",
        "summary": "Register a webserver process instance and its host machine",
        "description": "Bootstrap registration for the distributed Web Server cluster. The\nrequest must be authenticated with the shared cluster registration\ncredential; the response carries the instance's own heartbeat token\nand the initial peer directory. Idempotent per (machine code, PID):\nthe latest registration wins and receives a fresh token.",
        "tags": [
          "cluster"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-sdkwork-api-surface": "internal-api",
        "x-sdkwork-api-authority": "sdkwork-webserver-internal-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-auth-mode": "ingress-token",
        "x-sdkwork-route-auth": "ingress-token",
        "x-sdkwork-permission": "web.cluster.write",
        "x-sdkwork-idempotent": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "x-sdkwork-rate-limit-tier": "auth-critical",
        "x-sdkwork-owner": "sdkwork-webserver",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Instance registered (or re-registered) successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/responses/ClusterRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "SDKWork problem detail.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "SDKWork problem detail.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "SDKWork problem detail.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v3/api/web/cluster/instances/heartbeat": {
      "post": {
        "operationId": "cluster.instances.heartbeat",
        "summary": "Record one webserver instance heartbeat",
        "description": "Records instance liveness, health state, and resource metrics. The\nresponse refreshes the peer directory and delivers pending peer\nmailbox messages (at-most-once handoff).",
        "tags": [
          "cluster"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-sdkwork-api-surface": "internal-api",
        "x-sdkwork-api-authority": "sdkwork-webserver-internal-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-auth-mode": "ingress-token",
        "x-sdkwork-route-auth": "ingress-token",
        "x-sdkwork-permission": "web.cluster.write",
        "x-sdkwork-idempotent": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "x-sdkwork-rate-limit-tier": "auth-critical",
        "x-sdkwork-owner": "sdkwork-webserver",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterHeartbeatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat accepted with the refreshed peer directory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/responses/ClusterHeartbeatResponse"
                }
              }
            }
          },
          "400": {
            "description": "SDKWork problem detail.",
