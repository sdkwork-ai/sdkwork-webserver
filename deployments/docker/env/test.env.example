# sdkwork-webserver docker — test (embedded or external).
# Copy to deployments/docker/env/test.env and fill secrets.

SDKWORK_WEBSERVER_IMAGE_TAG=0.1.0
WEBSERVER_ENVIRONMENT=test
WEBSERVER_PROFILE_ID=standalone.test

SDKWORK_WEBSERVER_DEV_HOST_PORT=13800
SDKWORK_WEBSERVER_TEST_HOST_PORT=18888
SDKWORK_WEBSERVER_PROD_HOST_PORT=18080

WEBSERVER_POSTGRES_USER=postgres
WEBSERVER_POSTGRES_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_DB=postgres
PG_MAX_CONNECTIONS=200

WEBSERVER_POSTGRES_DEV_DB=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_USER=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_TEST_DB=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_USER=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_PROD_DB=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_USER=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_PASSWORD=<CHANGE_ME>

WEBSERVER_POSTGRES_SSL_MODE=disable

WEBSERVER_POSTGRES_HOST=postgres
WEBSERVER_POSTGRES_PORT=5432
WEBSERVER_REDIS_HOST=redis
WEBSERVER_REDIS_PORT=6379
WEBSERVER_REDIS_TLS=false
WEBSERVER_REDIS_PASSWORD=

SDKWORK_WEBSERVER_PRIMARY_DOMAIN=sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=http://server-test.sdkwork.com,http://server-test.birdcoder.com,http://server-test.dtupay.com,http://localhost:18888,http://127.0.0.1:18888
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-test.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-test.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-test.sdkwork.com

SDKWORK_WEBSERVER_NODE_UUID=webserver-test-0
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-0
RUST_LOG=info

SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=test
SDKWORK_WEBSERVER_PROFILE_ID=standalone.test
SDKWORK_WEBSERVER_RUNTIME_TARGET=container
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8888
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901

# WEBSERVER_POSTGRES_HOST=host.docker.internal
# WEBSERVER_REDIS_HOST=host.docker.internal
