# sdkwork-webserver docker — test (embedded or external).
# Copy to deployments/docker/env/test.env and fill secrets.

# Canonical paths: docs/guides/operator/CONFIG_PATHS.md
# Runtime TOML: /etc/sdkwork/webserver/config.toml

SDKWORK_WEBSERVER_IMAGE_TAG=0.1.0
WEBSERVER_ENVIRONMENT=test
WEBSERVER_PROFILE_ID=standalone.test

SDKWORK_WEBSERVER_DEV_HOST_PORT=13800
SDKWORK_WEBSERVER_TEST_HOST_PORT=18888
SDKWORK_WEBSERVER_PROD_HOST_PORT=18080
# Public data plane: container listens on 80/443. Host publishes:
SDKWORK_WEBSERVER_DEV_IMPORT_HTTP_HOST_PORT=80
SDKWORK_WEBSERVER_DEV_HTTPS_HOST_PORT=443
SDKWORK_WEBSERVER_TEST_IMPORT_HTTP_HOST_PORT=18898
SDKWORK_WEBSERVER_TEST_HTTPS_HOST_PORT=28430
SDKWORK_WEBSERVER_PROD_IMPORT_HTTP_HOST_PORT=18098
SDKWORK_WEBSERVER_PROD_HTTPS_HOST_PORT=38430
# Module-imports data plane (serve-imports): declared listeners 80/443
# (no SDKWORK_WEBSERVER_IMPORT_LISTENER_PORTS remap).

# Space clone + module imports (host /opt/deploy bind-mounted into containers)
SDKWORK_SPACE_ROOT=/opt/deploy
SDKWORK_SPACE_HOST_PATH=/opt/deploy
SDKWORK_SPACE_CLONE_URL=https://github.com/sdkwork-ai/sdkwork-space.git
SDKWORK_SPACE_CLONE_PULL=true
# Import every enabled sibling module's deployments/webserver/ from the
# space checkout (SDKWORK_WEBSERVER_SPEC.md §17). Leave MODULES empty when
# AUTO_DISCOVER=true; MODULES is an explicit pin only when AUTO_DISCOVER=false.
SDKWORK_SPACE_AUTO_DISCOVER=true
# Optional explicit override (comma-separated module ids) when AUTO_DISCOVER=false:
# SDKWORK_SPACE_MODULES=sdkwork-im,sdkwork-cloudrouter,sdkwork-birdcoder
SDKWORK_SPACE_MODULES=
SDKWORK_SPACE_CHECKOUT_HOST_PATH=/opt/deploy/sdkwork-space
SDKWORK_WEBSERVER_MODULE_IMPORT_REQUIRED=false
SDKWORK_WEBSERVER_MODULE_IMPORT_PROBE_UPSTREAMS=false

# Module /api/ backend proxy — see development.env.example for SDKWORK_MODULE_API_GATEWAY_* keys.
# Default: docker sibling (docker-compose.platform-api-gateway.yml).
SDKWORK_MODULE_API_GATEWAY_DEPLOYMENT=docker
SDKWORK_MODULE_API_GATEWAY_PORT=3900
SDKWORK_MODULE_API_GATEWAY_HOST_PORT=18900
# Shared identity for platform-api-gateway sibling (must match host Postgres).
SDKWORK_DATABASE_NAME=sdkwork_ai_test
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_test
SDKWORK_DATABASE_USERNAME=sdkwork_ai_test
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_MODULE_API_GATEWAY_HOST_PORT=18900

SDKWORK_DEPLOY_SANDBOX_KEY=deploy.local.opt_deploy
SDKWORK_DEPLOY_SANDBOX_ROOT=/opt/deploy

WEBSERVER_POSTGRES_USER=postgres
WEBSERVER_POSTGRES_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_DB=postgres
PG_MAX_CONNECTIONS=200

WEBSERVER_POSTGRES_DEV_DB=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_USER=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_TEST_DB=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_USER=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_PROD_DB=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_USER=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_PASSWORD=<CHANGE_ME>

WEBSERVER_POSTGRES_SSL_MODE=disable

WEBSERVER_POSTGRES_HOST=postgres
WEBSERVER_POSTGRES_PORT=5432
WEBSERVER_REDIS_HOST=redis
WEBSERVER_REDIS_PORT=6379
WEBSERVER_REDIS_TLS=false
WEBSERVER_REDIS_PASSWORD=

SDKWORK_WEBSERVER_PRIMARY_DOMAIN=sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=http://server-test.sdkwork.com:18888,http://server-app-test.sdkwork.com:18888,http://server-admin-test.sdkwork.com:18888,http://server-test.sdkwork.com,http://server-app-test.sdkwork.com,http://server-admin-test.sdkwork.com,http://localhost:18888,http://127.0.0.1:18888
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-test.sdkwork.com:18888
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-app-test.sdkwork.com:18888
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-admin-test.sdkwork.com:18888

SDKWORK_WEBSERVER_NODE_UUID=webserver-test-0
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-0
RUST_LOG=info

SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=test
SDKWORK_WEBSERVER_PROFILE_ID=standalone.test
SDKWORK_WEBSERVER_RUNTIME_TARGET=container
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3800
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901

# Adaptive Web console roots (process-owned; defaults match Dockerfile.standalone).
# SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc
# SDKWORK_WEBSERVER_H5_STATIC_ROOT=/app/share/sdkwork/webserver/web/h5
# SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/app/share/sdkwork/webserver/web/static

# WEBSERVER_POSTGRES_HOST=host.docker.internal
# WEBSERVER_REDIS_HOST=host.docker.internal
