# sdkwork-webserver docker — development (embedded or external).
# Copy to deployments/docker/env/development.env and fill secrets.
#
# Embedded (built-in postgres/redis):
#   bash scripts/docker/deploy-docker-environment.sh development
#
# External (host-native or managed postgres/redis):
#   bash scripts/docker/deploy-docker-environment.sh development --external

# Canonical runtime/data-plane paths: docs/guides/operator/CONFIG_PATHS.md
# Runtime TOML default: /etc/sdkwork/webserver/config.toml (entrypoint renders on boot)
# Override: SDKWORK_WEBSERVER_CONFIG_FILE

SDKWORK_WEBSERVER_IMAGE_TAG=0.1.0
WEBSERVER_ENVIRONMENT=development
WEBSERVER_PROFILE_ID=standalone.development

SDKWORK_WEBSERVER_DEV_HOST_PORT=13800
SDKWORK_WEBSERVER_TEST_HOST_PORT=18888
SDKWORK_WEBSERVER_PROD_HOST_PORT=18080
SDKWORK_WEBSERVER_DEV_HTTPS_HOST_PORT=18430
SDKWORK_WEBSERVER_TEST_HTTPS_HOST_PORT=28430
SDKWORK_WEBSERVER_PROD_HTTPS_HOST_PORT=38430

# Space clone + Drive deploy sandbox (host /opt/deploy bind-mounted into containers)
SDKWORK_SPACE_ROOT=/opt/deploy
SDKWORK_SPACE_HOST_PATH=/opt/deploy
SDKWORK_SPACE_CLONE_URL=https://github.com/Sdkwork-Cloud/sdkwork-space.git
SDKWORK_SPACE_CLONE_PULL=true
SDKWORK_SPACE_AUTO_DISCOVER=true
# Optional explicit override (comma-separated module ids):
# SDKWORK_SPACE_MODULES=sdkwork-im,sdkwork-cloudrouter,sdkwork-birdcoder
SDKWORK_WEBSERVER_MODULE_IMPORT_REQUIRED=false
SDKWORK_WEBSERVER_MODULE_IMPORT_PROBE_UPSTREAMS=false
SDKWORK_DEPLOY_SANDBOX_KEY=deploy.local.opt_deploy
SDKWORK_DEPLOY_SANDBOX_ROOT=/opt/deploy

# Built-in postgres admin (compose postgres service only).
WEBSERVER_POSTGRES_USER=postgres
WEBSERVER_POSTGRES_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_DB=postgres
PG_MAX_CONNECTIONS=200

# Canonical workspace identity (ENVIRONMENT_SPEC §7.1).
WEBSERVER_POSTGRES_DEV_DB=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_USER=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_TEST_DB=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_USER=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_PROD_DB=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_USER=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_PASSWORD=<CHANGE_ME>

WEBSERVER_POSTGRES_SSL_MODE=disable

# Embedded defaults (override for external mode).
WEBSERVER_POSTGRES_HOST=postgres
WEBSERVER_POSTGRES_PORT=5432
WEBSERVER_REDIS_HOST=redis
WEBSERVER_REDIS_PORT=6379
WEBSERVER_REDIS_TLS=false
WEBSERVER_REDIS_PASSWORD=

SDKWORK_WEBSERVER_PRIMARY_DOMAIN=sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=http://server-dev.sdkwork.com,http://localhost:13800,http://127.0.0.1:13800
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-dev.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-dev.sdkwork.com
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-dev.sdkwork.com

SDKWORK_WEBSERVER_NODE_UUID=webserver-development-0
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-dev-1
RUST_LOG=info

SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=development
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_RUNTIME_TARGET=container
SDKWORK_WEBSERVER_SNOWFLAKE_NODE_ID=0
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3800
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901

# Adaptive Web console roots (process-owned; defaults match Dockerfile.standalone).
# SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc
# SDKWORK_WEBSERVER_H5_STATIC_ROOT=/app/share/sdkwork/webserver/web/h5
# SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/app/share/sdkwork/webserver/web/static
# SDKWORK_WEBSERVER_TABLET_SURFACE=pc

SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_PROFILE_ID=standalone.development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_WEBSERVER_ACME_PROFILE=staging
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEBSERVER_ACME_WEBROOT=/var/lib/sdkwork/webserver/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/webserver/acme-accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=/var/lib/sdkwork/webserver/tls-materials
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/webserver/tls-materials/tls-runtime.json
SDKWORK_WEBSERVER_TLS_SNAPSHOT_ALPN=h2,http/1.1

# --- External mode overrides (uncomment when using --external) ---
# WEBSERVER_POSTGRES_HOST=host.docker.internal
# WEBSERVER_REDIS_HOST=host.docker.internal
