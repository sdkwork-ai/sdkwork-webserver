# sdkwork-webserver docker — development (embedded or external).
# Copy to deployments/docker/env/development.env and fill secrets.
#
# Embedded (built-in postgres/redis):
#   bash bin/docker-deploy.sh install --environment development
#
# External (host-native or managed postgres/redis):
#   bash bin/docker-deploy.sh install --environment development   # external host deps are the default

# Canonical runtime/data-plane paths: docs/guides/operator/CONFIG_PATHS.md
# Runtime TOML default: /etc/sdkwork/webserver/config.toml (entrypoint renders on boot)
# Override: SDKWORK_WEBSERVER_CONFIG_FILE

# Image tag: leave unset to inherit the bundle's packaged image (image.env).
# Active import set (SDKWORK_WEBSERVER_SPEC.md §17.3): which sibling-module
# edge set activates at startup — cloud (default) imports each module's
# nginx.cloud.<env>.conf (unified api-* edge -> gateway upstream);
# standalone imports nginx.standalone.<env>.conf (same-origin).
# Runtime switch without recreate: pnpm import:switch:cloud|standalone then
# restart serve-imports (import:status shows the active set).
SDKWORK_WEBSERVER_IMPORT_PROFILE=cloud
# Universal import plane (ENVIRONMENT_SPEC §6.2.2): environments this instance
# imports for every module. Default: this instance's environment only.
SDKWORK_WEBSERVER_IMPORT_ENVIRONMENTS=
# SDKWORK_WEBSERVER_IMAGE_TAG=0.1.0
WEBSERVER_ENVIRONMENT=development
WEBSERVER_PROFILE_ID=standalone.development

SDKWORK_WEBSERVER_DEV_HOST_PORT=13800
SDKWORK_WEBSERVER_TEST_HOST_PORT=18888
SDKWORK_WEBSERVER_PROD_HOST_PORT=18080
# Public data plane (modules + api*.brand): container listens on 80/443.
# Development publishes host 80/443 (requires host nginx uninstalled).
SDKWORK_WEBSERVER_DEV_IMPORT_HTTP_HOST_PORT=80
SDKWORK_WEBSERVER_DEV_HTTPS_HOST_PORT=443
SDKWORK_WEBSERVER_TEST_HTTPS_HOST_PORT=28430
SDKWORK_WEBSERVER_PROD_HTTPS_HOST_PORT=38430
# Test/prod multi-cluster host publishes (container still listens 80/443):
SDKWORK_WEBSERVER_TEST_IMPORT_HTTP_HOST_PORT=18898
SDKWORK_WEBSERVER_PROD_IMPORT_HTTP_HOST_PORT=18098
# Do not remap declared module listeners (identity 80/443). Leave empty.
# SDKWORK_WEBSERVER_IMPORT_LISTENER_PORTS=

# Space clone + Drive deploy sandbox (host /opt/deploy bind-mounted into containers)
SDKWORK_SPACE_ROOT=/opt/deploy
SDKWORK_SPACE_HOST_PATH=/opt/deploy
SDKWORK_SPACE_CLONE_URL=https://github.com/sdkwork-ai/sdkwork-space.git
SDKWORK_SPACE_CLONE_PULL=true
# Import every enabled sibling module's deployments/webserver/ from the
# space checkout (SDKWORK_WEBSERVER_SPEC.md §17). Leave MODULES empty when
# AUTO_DISCOVER=true; MODULES is an explicit pin only when AUTO_DISCOVER=false.
SDKWORK_SPACE_AUTO_DISCOVER=true
# Optional explicit override (comma-separated module ids) when AUTO_DISCOVER=false:
# SDKWORK_SPACE_MODULES=sdkwork-im,sdkwork-cloudrouter,sdkwork-birdcoder
SDKWORK_SPACE_MODULES=
SDKWORK_SPACE_CHECKOUT_HOST_PATH=/opt/deploy/sdkwork-space
SDKWORK_WEBSERVER_MODULE_IMPORT_REQUIRED=false
SDKWORK_WEBSERVER_MODULE_IMPORT_PROBE_UPSTREAMS=false

# Module /api/ backend proxy (sdkwork-api-cloud-gateway):
#   docker   — sibling container via docker-compose.platform-api-gateway.yml (default)
#   bundled  — second process inside the webserver container
#   external — operator-managed endpoint (set SDKWORK_MODULE_API_GATEWAY_HOST)
SDKWORK_MODULE_API_GATEWAY_DEPLOYMENT=docker
SDKWORK_MODULE_API_GATEWAY_PORT=8080
# Do not block webserver startup when the independent gateway is temporarily down.
SDKWORK_MODULE_API_GATEWAY_REQUIRED=false
# Mount sibling checkout so api*.brand nginx sidecars are always importable:
# SDKWORK_MODULE_API_GATEWAY_CHECKOUT_HOST_PATH=../../../sdkwork-api-cloud-gateway
# Host-published port for the platform-api-gateway sibling (overlay).
SDKWORK_MODULE_API_GATEWAY_HOST_PORT=13900
# Independent gateway already running (attach, do not start a second container):
# SDKWORK_MODULE_API_GATEWAY_ATTACH_NETWORK=sdkwork-gateway-development_default
# SDKWORK_MODULE_API_GATEWAY_HOST=gateway
# SDKWORK_MODULE_API_GATEWAY_HOST=
# SDKWORK_MODULE_API_GATEWAY_BINARY=/app/bin/sdkwork-api-cloud-gateway
# SDKWORK_MODULE_API_GATEWAY_INSTALL_ROOT=/opt/sdkwork/api-gateway
# Dev host mounts (docker-compose.development.yml) — only for bundled mode:
# SDKWORK_MODULE_API_GATEWAY_BINARY_HOST_PATH=../../../sdkwork-api-cloud-gateway/target/release/sdkwork-api-cloud-gateway
# SDKWORK_MODULE_API_GATEWAY_INSTALL_ROOT_HOST_PATH=../../../sdkwork-api-cloud-gateway/dist/container-image-build
# Docker sibling / independent gateway compose:
#   SDKWORK_MODULE_API_GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
# When using sdkwork-api-cloud-gateway's own docker-compose (service name
# `gateway`), attach the webserver to that network and set:
#   SDKWORK_MODULE_API_GATEWAY_HOST=gateway
#   SDKWORK_MODULE_API_GATEWAY_ATTACH_NETWORK=sdkwork-gateway-development_default
# Platform overlay (docker-compose.platform-api-gateway.yml) uses alias
# sdkwork-api-cloud-gateway instead.
# Optional explicit Host allow-list for the platform gateway (empty = allow all / auto):
# SDKWORK_MODULE_API_GATEWAY_ALLOWED_HOSTS=

SDKWORK_DEPLOY_SANDBOX_KEY=deploy.local.opt_deploy
SDKWORK_DEPLOY_SANDBOX_ROOT=/opt/deploy

# Built-in postgres admin (compose postgres service only).
WEBSERVER_POSTGRES_USER=postgres
WEBSERVER_POSTGRES_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_DB=postgres
PG_MAX_CONNECTIONS=200

# Canonical workspace identity (ENVIRONMENT_SPEC §7.1).
WEBSERVER_POSTGRES_DEV_DB=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_USER=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_TEST_DB=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_USER=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_PROD_DB=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_USER=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_PASSWORD=<CHANGE_ME>

WEBSERVER_POSTGRES_SSL_MODE=disable

# Host-system external services (default): the docker host's own PostgreSQL
# and Redis, reached via host.docker.internal (5432 / 6379). The development
# identity below is identical to `.env.postgres` used by `pnpm dev`.
WEBSERVER_POSTGRES_HOST=host.docker.internal
WEBSERVER_POSTGRES_PORT=5432
WEBSERVER_REDIS_HOST=host.docker.internal
WEBSERVER_REDIS_PORT=6379
WEBSERVER_REDIS_TLS=false
WEBSERVER_REDIS_PASSWORD=

# Webserver runtime connection (must match the host-system services above).
SDKWORK_DATABASE_HOST=host.docker.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_WEBSERVER_REDIS_HOST=host.docker.internal
SDKWORK_WEBSERVER_REDIS_PORT=6379

SDKWORK_WEBSERVER_PRIMARY_DOMAIN=sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://server-dev.sdkwork.com,http://server-dev.sdkwork.com,https://server-dev.birdcoder.com,http://server-dev.birdcoder.com,https://server-dev.dtupay.com,http://server-dev.dtupay.com,https://server-dev.noaper.com,http://server-dev.noaper.com,https://server-dev.sdkwork.cn,http://server-dev.sdkwork.cn,https://server-dev.birdcoder.cn,http://server-dev.birdcoder.cn,https://server-dev.dtupay.cn,http://server-dev.dtupay.cn,https://server-dev.noaper.cn,http://server-dev.noaper.cn,https://server-dev.skubc.com,http://server-dev.skubc.com,https://server-dev.skubc.cn,http://server-dev.skubc.cn,https://server-dev.zowalk.com,http://server-dev.zowalk.com,https://server-dev.zowalk.cn,http://server-dev.zowalk.cn,https://server-dev.offer86.com,http://server-dev.offer86.com,https://server-dev.offer86.cn,http://server-dev.offer86.cn,https://server-dev.86offer.com,http://server-dev.86offer.com,https://server-dev.86offer.cn,http://server-dev.86offer.cn,https://server-app-dev.sdkwork.com,http://server-app-dev.sdkwork.com,https://server-app-dev.birdcoder.com,http://server-app-dev.birdcoder.com,https://server-app-dev.dtupay.com,http://server-app-dev.dtupay.com,https://server-app-dev.noaper.com,http://server-app-dev.noaper.com,https://server-app-dev.sdkwork.cn,http://server-app-dev.sdkwork.cn,https://server-app-dev.birdcoder.cn,http://server-app-dev.birdcoder.cn,https://server-app-dev.dtupay.cn,http://server-app-dev.dtupay.cn,https://server-app-dev.noaper.cn,http://server-app-dev.noaper.cn,https://server-app-dev.skubc.com,http://server-app-dev.skubc.com,https://server-app-dev.skubc.cn,http://server-app-dev.skubc.cn,https://server-app-dev.zowalk.com,http://server-app-dev.zowalk.com,https://server-app-dev.zowalk.cn,http://server-app-dev.zowalk.cn,https://server-app-dev.offer86.com,http://server-app-dev.offer86.com,https://server-app-dev.offer86.cn,http://server-app-dev.offer86.cn,https://server-app-dev.86offer.com,http://server-app-dev.86offer.com,https://server-app-dev.86offer.cn,http://server-app-dev.86offer.cn,https://server-admin-dev.sdkwork.com,http://server-admin-dev.sdkwork.com,https://server-admin-dev.birdcoder.com,http://server-admin-dev.birdcoder.com,https://server-admin-dev.dtupay.com,http://server-admin-dev.dtupay.com,https://server-admin-dev.noaper.com,http://server-admin-dev.noaper.com,https://server-admin-dev.sdkwork.cn,http://server-admin-dev.sdkwork.cn,https://server-admin-dev.birdcoder.cn,http://server-admin-dev.birdcoder.cn,https://server-admin-dev.dtupay.cn,http://server-admin-dev.dtupay.cn,https://server-admin-dev.noaper.cn,http://server-admin-dev.noaper.cn,https://server-admin-dev.skubc.com,http://server-admin-dev.skubc.com,https://server-admin-dev.skubc.cn,http://server-admin-dev.skubc.cn,https://server-admin-dev.zowalk.com,http://server-admin-dev.zowalk.com,https://server-admin-dev.zowalk.cn,http://server-admin-dev.zowalk.cn,https://server-admin-dev.offer86.com,http://server-admin-dev.offer86.com,https://server-admin-dev.offer86.cn,http://server-admin-dev.offer86.cn,https://server-admin-dev.86offer.com,http://server-admin-dev.86offer.com,https://server-admin-dev.86offer.cn,http://server-admin-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-dev.sdkwork.com:13800
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-app-dev.sdkwork.com:13800
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-admin-dev.sdkwork.com:13800

SDKWORK_WEBSERVER_NODE_UUID=webserver-development-0
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-dev-1
RUST_LOG=info

SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=development
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=development
SDKWORK_WEBSERVER_PROFILE_ID=standalone.development
SDKWORK_WEBSERVER_RUNTIME_TARGET=container
SDKWORK_WEBSERVER_SNOWFLAKE_NODE_ID=0
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3800
# Non-loopback public ingress also exposes unauthenticated health probes;
# the edge snippets deny /metrics and /livez, metrics are scraped via the
# loopback operations listener (SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND).
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901

# Adaptive Web console roots (process-owned; defaults match Dockerfile.standalone).
# SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc
# SDKWORK_WEBSERVER_H5_STATIC_ROOT=/app/share/sdkwork/webserver/web/h5
# SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/app/share/sdkwork/webserver/web/static
# SDKWORK_WEBSERVER_TABLET_SURFACE=pc

SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_PROFILE_ID=standalone.development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_WEBSERVER_ACME_PROFILE=staging
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEBSERVER_ACME_WEBROOT=/var/lib/sdkwork/webserver/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/webserver/acme-accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEBSERVER_TLS_MATERIAL_ROOT=/var/lib/sdkwork/webserver/tls-materials
SDKWORK_WEBSERVER_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/webserver/tls-materials/tls-runtime.json
SDKWORK_WEBSERVER_TLS_SNAPSHOT_ALPN=h2,http/1.1

# --- Embedded mode (opt in with deploy.sh --embedded) ---
# Point the webserver back at the built-in postgres/redis containers:
# WEBSERVER_POSTGRES_HOST=postgres
# WEBSERVER_REDIS_HOST=redis
# SDKWORK_DATABASE_HOST=postgres
# SDKWORK_WEBSERVER_REDIS_HOST=redis

# --- Drive delivery cache (shared host directory, LRU website content cache) ---
# Host directory bind-mounted to /opt/deploy/drive; entries are immutable and
# content-addressed so all webserver instances on this host share one cache.
# SDKWORK_DRIVE_CACHE_HOST_PATH=/opt/deploy/drive
SDKWORK_DRIVE_WEBSITE_CACHE_ENABLED=true
SDKWORK_DRIVE_WEBSITE_CACHE_ROOT=/opt/deploy/drive/website-cache
SDKWORK_DRIVE_WEBSITE_CACHE_MAX_TOTAL_BYTES=8589934592
SDKWORK_DRIVE_WEBSITE_CACHE_MAX_ENTRIES=100000
SDKWORK_MODULE_API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3910,http://127.0.0.1:3910
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_LABELS=account,admin,agent,agents,agents-admin,agents-app,agents-open,agentstudio,agentstudio-admin,agentstudio-app,aiot,aiot-admin,aiot-app,api,appbase,appstore,assets,audio,audio-api,birdcoder2,browser,canvas,cloudrouter,cms,code,codebox,community,company,console,course,customer-service,deploy,deploy-admin,deploy-app,dezhou,discovery,discovery-admin,doc,documents,documents-admin,documents-open,doudizhu,drama,drive,drive-internal,events,feeds,forum,gameengine,games,generations,github,github-workflow,harness,iam,im,image,inventory,invoice,kernel,knowledge,knowledgebase,knowledgebase-admin,llm,llm-admin,llm-app,llm-open,local-router,mahjong,mail,mcp,mem,membership,memory,memory-admin,memory-app,memory-open,merchandise,messaging,modelkit,models,music,news,notary,notary-admin,notes,order,partner,payment,portal,promotion,prompts,router,router-admin,router-open,rtc,search,server,server-admin,server-app,settings,shop,skills,terminal,tts,video,video-cut,voice,web-internal,web-provider-events,xiangqi
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_SUFFIX=-dev
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_SCHEMES=http,https
SDKWORK_CORS_CONSOLE_HOST_LABELS=account,admin,agent,agents,agents-admin,agents-app,agents-open,agentstudio,agentstudio-admin,agentstudio-app,aiot,aiot-admin,aiot-app,api,appbase,appstore,assets,audio,audio-api,birdcoder2,browser,canvas,cloudrouter,cms,code,codebox,community,company,console,course,customer-service,deploy,deploy-admin,deploy-app,dezhou,discovery,discovery-admin,doc,documents,documents-admin,documents-open,doudizhu,drama,drive,drive-internal,events,feeds,forum,gameengine,games,generations,github,github-workflow,harness,iam,im,image,inventory,invoice,kernel,knowledge,knowledgebase,knowledgebase-admin,llm,llm-admin,llm-app,llm-open,local-router,mahjong,mail,mcp,mem,membership,memory,memory-admin,memory-app,memory-open,merchandise,messaging,modelkit,models,music,news,notary,notary-admin,notes,order,partner,payment,portal,promotion,prompts,router,router-admin,router-open,rtc,search,server,server-admin,server-app,settings,shop,skills,terminal,tts,video,video-cut,voice,web-internal,web-provider-events,xiangqi
SDKWORK_CORS_CONSOLE_HOST_SUFFIX=-dev
SDKWORK_CORS_CONSOLE_HOST_SCHEMES=http,https
