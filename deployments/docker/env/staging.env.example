# sdkwork-webserver docker — staging (external, production-like rehearsal).
# Copy to deployments/docker/env/staging.env and fill secrets.

# Canonical paths: docs/guides/operator/CONFIG_PATHS.md
# Runtime TOML: /etc/sdkwork/webserver/config.toml

# Image tag: leave unset to inherit the bundle's packaged image (image.env).
# Active import set (SDKWORK_WEBSERVER_SPEC.md §17.3): which sibling-module
# edge set activates at startup — cloud (default) imports each module's
# nginx.cloud.<env>.conf (unified api-* edge -> gateway upstream);
# standalone imports nginx.standalone.<env>.conf (same-origin).
# Runtime switch without recreate: pnpm import:switch:cloud|standalone then
# restart serve-imports (import:status shows the active set).
SDKWORK_WEBSERVER_IMPORT_PROFILE=cloud
# Universal import plane (ENVIRONMENT_SPEC.md §6.2.2,
# SDKWORK_WEBSERVER_SPEC.md §17.3.2): the lifecycle environments whose module
# sidecars this instance imports. All five is the default commission — a deployed
# instance is the shared edge for every commissioned domain edge, and an empty
# value means the same thing. SDKWORK_WEBSERVER_ENVIRONMENT above only selects
# this instance's default routing environment; it never narrows this set.
SDKWORK_WEBSERVER_IMPORT_ENVIRONMENTS=development,test,staging,demo,production
# SDKWORK_WEBSERVER_IMAGE_TAG=0.1.0
WEBSERVER_ENVIRONMENT=staging
WEBSERVER_PROFILE_ID=standalone.staging

SDKWORK_WEBSERVER_DEV_HOST_PORT=13800
SDKWORK_WEBSERVER_TEST_HOST_PORT=18888
SDKWORK_WEBSERVER_STAGING_HOST_PORT=18081
SDKWORK_WEBSERVER_PROD_HOST_PORT=18080
# Public data plane: container listens on 80/443. Host publishes:
SDKWORK_WEBSERVER_DEV_IMPORT_HTTP_HOST_PORT=80
SDKWORK_WEBSERVER_DEV_HTTPS_HOST_PORT=443
SDKWORK_WEBSERVER_TEST_IMPORT_HTTP_HOST_PORT=18898
SDKWORK_WEBSERVER_TEST_HTTPS_HOST_PORT=28430
SDKWORK_WEBSERVER_STAGING_IMPORT_HTTP_HOST_PORT=18099
SDKWORK_WEBSERVER_STAGING_HTTPS_HOST_PORT=38431
SDKWORK_WEBSERVER_PROD_IMPORT_HTTP_HOST_PORT=18098
SDKWORK_WEBSERVER_PROD_HTTPS_HOST_PORT=38430
# Module-imports data plane (serve-imports): declared listeners 80/443
# (no SDKWORK_WEBSERVER_IMPORT_LISTENER_PORTS remap).

# Space clone + module imports (host /opt/deploy bind-mounted into containers)
SDKWORK_SPACE_ROOT=/opt/deploy
SDKWORK_SPACE_HOST_PATH=/opt/deploy
SDKWORK_SPACE_CLONE_URL=https://github.com/sdkwork-ai/sdkwork-space.git
SDKWORK_SPACE_CLONE_PULL=true
# Import every enabled sibling module's deployments/webserver/ from the
# space checkout (SDKWORK_WEBSERVER_SPEC.md §17). Leave MODULES empty when
# AUTO_DISCOVER=true; MODULES is an explicit pin only when AUTO_DISCOVER=false.
SDKWORK_SPACE_AUTO_DISCOVER=true
# Optional explicit override (comma-separated module ids) when AUTO_DISCOVER=false:
# SDKWORK_SPACE_MODULES=sdkwork-im,sdkwork-cloudrouter,sdkwork-birdcoder
SDKWORK_SPACE_MODULES=
SDKWORK_SPACE_CHECKOUT_HOST_PATH=/opt/deploy/sdkwork-space
SDKWORK_WEBSERVER_MODULE_IMPORT_REQUIRED=false
SDKWORK_WEBSERVER_MODULE_IMPORT_PROBE_UPSTREAMS=false

# Module /api/ backend proxy — see development.env.example for SDKWORK_MODULE_API_GATEWAY_* keys.
# Default: docker sibling (docker-compose.platform-api-gateway.yml).
SDKWORK_MODULE_API_GATEWAY_DEPLOYMENT=docker
SDKWORK_MODULE_API_GATEWAY_PORT=8080
SDKWORK_MODULE_API_GATEWAY_HOST_PORT=18091
# Shared identity for platform-api-gateway sibling (must match host Postgres).
SDKWORK_DATABASE_NAME=sdkwork_ai_staging
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_staging
SDKWORK_DATABASE_USERNAME=sdkwork_ai_staging
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
# External host-system services (default): docker host PostgreSQL 5432 / Redis 6379.
SDKWORK_DATABASE_HOST=host.docker.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_WEBSERVER_REDIS_HOST=host.docker.internal
SDKWORK_WEBSERVER_REDIS_PORT=6379

SDKWORK_DEPLOY_SANDBOX_KEY=deploy.local.opt_deploy
SDKWORK_DEPLOY_SANDBOX_ROOT=/opt/deploy

WEBSERVER_POSTGRES_USER=postgres
WEBSERVER_POSTGRES_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_DB=postgres
PG_MAX_CONNECTIONS=200

WEBSERVER_POSTGRES_DEV_DB=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_USER=sdkwork_ai_dev
WEBSERVER_POSTGRES_DEV_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_TEST_DB=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_USER=sdkwork_ai_test
WEBSERVER_POSTGRES_TEST_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_STAGING_DB=sdkwork_ai_staging
WEBSERVER_POSTGRES_STAGING_USER=sdkwork_ai_staging
WEBSERVER_POSTGRES_STAGING_PASSWORD=<CHANGE_ME>
WEBSERVER_POSTGRES_PROD_DB=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_USER=sdkwork_ai_prod
WEBSERVER_POSTGRES_PROD_PASSWORD=<CHANGE_ME>

WEBSERVER_POSTGRES_SSL_MODE=disable

# Host-system external services (default): the docker host's own PostgreSQL
# and Redis, reached via host.docker.internal (5432 / 6379).
WEBSERVER_POSTGRES_HOST=host.docker.internal
WEBSERVER_POSTGRES_PORT=5432
WEBSERVER_REDIS_HOST=host.docker.internal
WEBSERVER_REDIS_PORT=6379
WEBSERVER_REDIS_TLS=false
WEBSERVER_REDIS_PASSWORD=

SDKWORK_WEBSERVER_PRIMARY_DOMAIN=sdkwork.com
# Staging hostnames follow APP_RUNTIME_TOPOLOGY_NAMING §9 (-staging suffix);
# registered first-party client origins (WEB_FRAMEWORK_SPEC §12) are always
# merged by runtime assembly and repeated here for operator visibility.
SDKWORK_CORS_ALLOWED_ORIGINS=https://server-staging.sdkwork.com,http://server-staging.sdkwork.com,https://server-staging.birdcoder.com,http://server-staging.birdcoder.com,https://server-staging.dtupay.com,http://server-staging.dtupay.com,https://server-staging.noaper.com,http://server-staging.noaper.com,https://server-staging.sdkwork.cn,http://server-staging.sdkwork.cn,https://server-staging.birdcoder.cn,http://server-staging.birdcoder.cn,https://server-staging.dtupay.cn,http://server-staging.dtupay.cn,https://server-staging.noaper.cn,http://server-staging.noaper.cn,https://server-staging.skubc.com,http://server-staging.skubc.com,https://server-staging.skubc.cn,http://server-staging.skubc.cn,https://server-staging.zowalk.com,http://server-staging.zowalk.com,https://server-staging.zowalk.cn,http://server-staging.zowalk.cn,https://server-staging.offer86.com,http://server-staging.offer86.com,https://server-staging.offer86.cn,http://server-staging.offer86.cn,https://server-staging.86offer.com,http://server-staging.86offer.com,https://server-staging.86offer.cn,http://server-staging.86offer.cn,https://server-app-staging.sdkwork.com,http://server-app-staging.sdkwork.com,https://server-app-staging.birdcoder.com,http://server-app-staging.birdcoder.com,https://server-app-staging.dtupay.com,http://server-app-staging.dtupay.com,https://server-app-staging.noaper.com,http://server-app-staging.noaper.com,https://server-app-staging.sdkwork.cn,http://server-app-staging.sdkwork.cn,https://server-app-staging.birdcoder.cn,http://server-app-staging.birdcoder.cn,https://server-app-staging.dtupay.cn,http://server-app-staging.dtupay.cn,https://server-app-staging.noaper.cn,http://server-app-staging.noaper.cn,https://server-app-staging.skubc.com,http://server-app-staging.skubc.com,https://server-app-staging.skubc.cn,http://server-app-staging.skubc.cn,https://server-app-staging.zowalk.com,http://server-app-staging.zowalk.com,https://server-app-staging.zowalk.cn,http://server-app-staging.zowalk.cn,https://server-app-staging.offer86.com,http://server-app-staging.offer86.com,https://server-app-staging.offer86.cn,http://server-app-staging.offer86.cn,https://server-app-staging.86offer.com,http://server-app-staging.86offer.com,https://server-app-staging.86offer.cn,http://server-app-staging.86offer.cn,https://server-admin-staging.sdkwork.com,http://server-admin-staging.sdkwork.com,https://server-admin-staging.birdcoder.com,http://server-admin-staging.birdcoder.com,https://server-admin-staging.dtupay.com,http://server-admin-staging.dtupay.com,https://server-admin-staging.noaper.com,http://server-admin-staging.noaper.com,https://server-admin-staging.sdkwork.cn,http://server-admin-staging.sdkwork.cn,https://server-admin-staging.birdcoder.cn,http://server-admin-staging.birdcoder.cn,https://server-admin-staging.dtupay.cn,http://server-admin-staging.dtupay.cn,https://server-admin-staging.noaper.cn,http://server-admin-staging.noaper.cn,https://server-admin-staging.skubc.com,http://server-admin-staging.skubc.com,https://server-admin-staging.skubc.cn,http://server-admin-staging.skubc.cn,https://server-admin-staging.zowalk.com,http://server-admin-staging.zowalk.com,https://server-admin-staging.zowalk.cn,http://server-admin-staging.zowalk.cn,https://server-admin-staging.offer86.com,http://server-admin-staging.offer86.com,https://server-admin-staging.offer86.cn,http://server-admin-staging.offer86.cn,https://server-admin-staging.86offer.com,http://server-admin-staging.86offer.com,https://server-admin-staging.86offer.cn,http://server-admin-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL=http://server-staging.sdkwork.com:18081
SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL=http://server-app-staging.sdkwork.com:18081
SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL=http://server-admin-staging.sdkwork.com:18081
SDKWORK_WEBSERVER_PUBLIC_SCHEME=http

SDKWORK_WEBSERVER_NODE_UUID=webserver-staging-0
SDKWORK_WEBSERVER_CERT_WORKER_ID=certificate-worker-0
SDKWORK_WEBSERVER_ACME_PROFILE=production
SDKWORK_WEBSERVER_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# ACME_CONTACT_EMAIL and ACME_ACCOUNT_ROOT are REQUIRED in production-like
# environments (test/staging/production): the gateway refuses to start without a
# durable account store, and the CA requires a contact address. The account root
# must live on a persistent volume so the ACME account identity (and the CA
# account-creation rate limit) survives container recreation.
SDKWORK_WEBSERVER_ACME_CONTACT_EMAIL=admin@sdkwork.com
SDKWORK_WEBSERVER_ACME_WEBROOT=/var/lib/sdkwork/webserver/acme-webroot
SDKWORK_WEBSERVER_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/webserver/acme-accounts
SDKWORK_WEBSERVER_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEBSERVER_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEBSERVER_CERT_RENEW_SCAN_INTERVAL_SECS=3600
RUST_LOG=info

SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEBSERVER_ENVIRONMENT=staging
SDKWORK_WEBSERVER_PROFILE_ID=standalone.staging
SDKWORK_WEBSERVER_RUNTIME_TARGET=container
SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3800
# Non-loopback public ingress also exposes unauthenticated health probes;
# the edge snippets deny /metrics and /livez, metrics are scraped via the
# loopback operations listener (SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND).
SDKWORK_WEBSERVER_MANAGEMENT_EXPOSE_ALLOWED=true
SDKWORK_WEBSERVER_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901

# Adaptive Web console roots (process-owned; defaults match Dockerfile.standalone).
# SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc
# SDKWORK_WEBSERVER_H5_STATIC_ROOT=/app/share/sdkwork/webserver/web/h5
# SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/app/share/sdkwork/webserver/web/static

# --- Embedded mode (opt in with deploy.sh --embedded) ---
# Point the webserver back at the built-in postgres/redis containers:
# WEBSERVER_POSTGRES_HOST=postgres
# WEBSERVER_REDIS_HOST=redis
# SDKWORK_DATABASE_HOST=postgres
# SDKWORK_WEBSERVER_REDIS_HOST=redis
# WEBSERVER_POSTGRES_SSL_MODE=require
# WEBSERVER_REDIS_TLS=true

# --- Drive delivery cache (shared host directory, LRU website content cache) ---
# Host directory bind-mounted to /opt/deploy/drive; entries are immutable and
# content-addressed so all webserver instances on this host share one cache.
# SDKWORK_DRIVE_CACHE_HOST_PATH=/opt/deploy/drive
SDKWORK_DRIVE_WEBSITE_CACHE_ENABLED=true
SDKWORK_DRIVE_WEBSITE_CACHE_ROOT=/opt/deploy/drive/website-cache
SDKWORK_DRIVE_WEBSITE_CACHE_MAX_TOTAL_BYTES=8589934592
SDKWORK_DRIVE_WEBSITE_CACHE_MAX_ENTRIES=100000
SDKWORK_MODULE_API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3912,http://127.0.0.1:3912
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_LABELS=account,admin,agent,agents,agents-admin,agents-app,agents-open,agentstudio,agentstudio-admin,agentstudio-app,aiot,aiot-admin,aiot-app,api,appbase,appstore,assets,audio,audio-api,birdcoder2,browser,canvas,cloudrouter,cms,code,codebox,community,company,console,course,customer-service,deploy,deploy-admin,deploy-app,dezhou,discovery,discovery-admin,doc,documents,documents-admin,documents-open,doudizhu,drama,drive,drive-internal,events,feeds,forum,gameengine,games,generations,github,github-workflow,harness,iam,im,image,inventory,invoice,kernel,knowledge,knowledgebase,knowledgebase-admin,llm,llm-admin,llm-app,llm-open,local-router,mahjong,mail,mcp,mem,membership,memory,memory-admin,memory-app,memory-open,merchandise,messaging,modelkit,models,music,news,notary,notary-admin,notes,order,partner,payment,portal,promotion,prompts,router,router-admin,router-open,rtc,search,server,server-admin,server-app,settings,shop,skills,terminal,tts,video,video-cut,voice,web-internal,web-provider-events,xiangqi
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_SUFFIX=-staging
SDKWORK_MODULE_API_GATEWAY_CORS_CONSOLE_HOST_SCHEMES=http,https
SDKWORK_CORS_CONSOLE_HOST_LABELS=account,admin,agent,agents,agents-admin,agents-app,agents-open,agentstudio,agentstudio-admin,agentstudio-app,aiot,aiot-admin,aiot-app,api,appbase,appstore,assets,audio,audio-api,birdcoder2,browser,canvas,cloudrouter,cms,code,codebox,community,company,console,course,customer-service,deploy,deploy-admin,deploy-app,dezhou,discovery,discovery-admin,doc,documents,documents-admin,documents-open,doudizhu,drama,drive,drive-internal,events,feeds,forum,gameengine,games,generations,github,github-workflow,harness,iam,im,image,inventory,invoice,kernel,knowledge,knowledgebase,knowledgebase-admin,llm,llm-admin,llm-app,llm-open,local-router,mahjong,mail,mcp,mem,membership,memory,memory-admin,memory-app,memory-open,merchandise,messaging,modelkit,models,music,news,notary,notary-admin,notes,order,partner,payment,portal,promotion,prompts,router,router-admin,router-open,rtc,search,server,server-admin,server-app,settings,shop,skills,terminal,tts,video,video-cut,voice,web-internal,web-provider-events,xiangqi
SDKWORK_CORS_CONSOLE_HOST_SUFFIX=-staging
SDKWORK_CORS_CONSOLE_HOST_SCHEMES=http,https
