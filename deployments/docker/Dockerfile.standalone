FROM debian:bookworm-slim

# Full language toolchain: Python 3, Node.js + pnpm, and Rust — the container
# can build and execute SDKWork module apps (H5/PC) and Rust libraries in
# place. Tools install at system scope so the unprivileged `sdkwork` user
# executes them through PATH without extra privileges.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        openssl \
        util-linux \
        git \
        python3 \
        python3-pip \
        python3-venv \
        nodejs \
        npm \
        rustc \
        cargo \
    && npm install --global --no-fund --no-audit pnpm \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 sdkwork \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sdkwork

WORKDIR /app

# Build context: verified sdkwork-webserver/ release root staged by scripts/docker/build-standalone-image.mjs.
COPY --chown=10001:10001 . /app/
COPY entrypoint-standalone.sh /usr/local/bin/sdkwork-webserver-entrypoint

RUN chmod 0755 /usr/local/bin/sdkwork-webserver-entrypoint \
    && install -d -o sdkwork -g sdkwork -m 0750 \
        /etc/sdkwork/webserver/secrets \
        /etc/sdkwork/certs \
        /var/lib/sdkwork/webserver/acme-webroot \
        /var/lib/sdkwork/webserver/acme-accounts \
        /var/lib/sdkwork/webserver/tls-materials \
        /opt/deploy \
    && chown sdkwork:sdkwork /opt/deploy

ENV SDKWORK_WEBSERVER_APP_ROOT=/app \
    SDKWORK_WEBSERVER_SERVER_APP_ROOT=/app \
    SDKWORK_APP_ROOT=/app \
    SDKWORK_IAM_APP_ROOT=/app/share/sdkwork/iam \
    SDKWORK_DRIVE_APP_ROOT=/app/share/sdkwork/drive \
    SDKWORK_DEPLOY_APP_ROOT=/app/share/sdkwork/deploy \
    SDKWORK_WEB_STORE_APP_ROOT=/app/share/sdkwork/webstore \
    SDKWORK_SKILLS_APP_ROOT=/app/share/sdkwork/skills \
    SDKWORK_MCP_APP_ROOT=/app/share/sdkwork/mcp \
    SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc \
    SDKWORK_WEBSERVER_H5_STATIC_ROOT=/app/share/sdkwork/webserver/web/h5 \
    SDKWORK_WEBSERVER_STATIC_FALLBACK_ROOT=/app/share/sdkwork/webserver/web/static \
    SDKWORK_WEBSERVER_TABLET_SURFACE=pc \
    SDKWORK_WEBSERVER_RUNTIME_TARGET=container \
    SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone \
    # Language toolchain environment
    PATH="/usr/local/bin:/usr/bin:/bin:/root/.local/share/pnpm:${PATH}" \
    PNPM_HOME="/root/.local/share/pnpm" \
    CARGO_HOME="/root/.cargo" \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    # SDKWork space clone surface (A3): clone target and module import
    # activation for the sdkwork-webserver container.
    SDKWORK_SPACE_ROOT=/opt/deploy \
    SDKWORK_SPACE_CLONE_URL=https://github.com/sdkwork-ai/sdkwork-space.git \
    SDKWORK_SPACE_CLONE_PULL=true \
    SDKWORK_DEPLOY_SANDBOX_KEY=deploy.local.opt_deploy \
    SDKWORK_DEPLOY_SANDBOX_ROOT=/opt/deploy

EXPOSE 3800 8888 8080

ENTRYPOINT ["/usr/local/bin/sdkwork-webserver-entrypoint"]
CMD ["serve-management"]
