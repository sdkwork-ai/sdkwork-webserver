FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openssl util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 sdkwork \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sdkwork

WORKDIR /app

# Build context: verified sdkwork-webserver/ release root staged by scripts/docker/build-standalone-image.mjs.
COPY --chown=10001:10001 . /app/
COPY entrypoint-standalone.sh /usr/local/bin/sdkwork-webserver-entrypoint

RUN chmod 0755 /usr/local/bin/sdkwork-webserver-entrypoint \
    && install -d -o sdkwork -g sdkwork -m 0750 \
        /etc/sdkwork/webserver/secrets \
        /var/lib/sdkwork/webserver/acme-webroot \
        /var/lib/sdkwork/webserver/acme-accounts \
        /var/lib/sdkwork/webserver/tls-materials

ENV SDKWORK_WEBSERVER_APP_ROOT=/app \
    SDKWORK_WEBSERVER_SERVER_APP_ROOT=/app \
    SDKWORK_APP_ROOT=/app \
    SDKWORK_IAM_APP_ROOT=/app/share/sdkwork/iam \
    SDKWORK_DRIVE_APP_ROOT=/app/share/sdkwork/drive \
    SDKWORK_WEBSERVER_PC_STATIC_ROOT=/app/share/sdkwork/webserver/web/pc \
    SDKWORK_WEBSERVER_RUNTIME_TARGET=container \
    SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE=standalone

EXPOSE 3800 8888 8080

ENTRYPOINT ["/usr/local/bin/sdkwork-webserver-entrypoint"]
CMD ["serve-management"]
