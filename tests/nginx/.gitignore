# Nginx fixture runtime artifacts (never commit)
*.pid
*.log
error.log
access.log
cert.pem
key.pem
**/logs/*
!**/logs/.gitkeep
**/temp/**/*
!**/temp/**/.gitkeep
# rendered per run by the differential + full-surface runners
**/nginx.rendered.conf
full-surface/htpasswd
full-surface/*.pem
full-surface/cache/
