#!/bin/bash
# prerm for the sdkwork-webserver package (environment: __ENVIRONMENT__).
# Stops the service before removal or upgrade; keeps configuration data.
# Upgrade contract: the stop happens BEFORE the new package unpacks so
# schema migrations never run against a serving old binary; on a
# single-host standalone install this is a bounded maintenance window
# (TimeoutStopSec=45 + postinst start + health gate). Rolling upgrades
# belong to the container channel (deploy.sh --replicas >= 2).

set -euo pipefail

SERVICE_NAME="__SERVICE_NAME__"

if [ "$1" = "remove" ] || [ "$1" = "upgrade" ] || [ "$1" = "deconfigure" ]; then
  if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
    systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi
  if systemctl is-active --quiet sdkwork-webserver-certificate-worker 2>/dev/null; then
    systemctl stop sdkwork-webserver-certificate-worker >/dev/null 2>&1 || true
  fi
fi

exit 0
