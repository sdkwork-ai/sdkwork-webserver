[Unit]
Description=SDKWork Web Server standalone gateway (__ENVIRONMENT__)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sdkwork
Group=sdkwork
# The typed runtime configuration (/etc/sdkwork/webserver/config.toml)
# is loaded by the binary at startup; secret material is referenced by file
# path inside the TOML, never injected through EnvironmentFile.
ExecStart=/usr/lib/sdkwork/webserver/bin/sdkwork-api-webserver-standalone-gateway serve-management
Restart=on-failure
RestartSec=5s
# Explicit lifecycle budgets: the process drains accepted work for up to
# 30s (drain_timeout), so 45s gives systemd a bounded stop instead of the
# implicit 90s default; start includes database bootstrap + drift checks.
TimeoutStopSec=45
TimeoutStartSec=180
# Zero-downtime executable upgrade (PRD-production-operations §8): the
# gateway adopts LISTEN_FDS descriptors (systemd socket activation) when
# present, so a socket-activated deployment can restart the service with a
# new binary while the socket units keep the listening sockets open — no
# accept gap, no dropped connection. Configure the public listeners through
# .socket units and pass them in the declared socket-set order to enable it.
LimitNOFILE=65536
# Last-resort memory backstop behind the process admission controller
# (PRD §8.1: bounded rejection, not allocator exhaustion). Tune per host.
MemoryMax=4G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sdkwork/webserver /run/sdkwork/webserver
PrivateTmp=true

[Install]
WantedBy=multi-user.target
