# SDKWork Web Server public edge configuration (production).
# Rendered by the postinst from
# /usr/lib/sdkwork/webserver/share/nginx.production.conf.template and served
# by the gateway's nginx-compat data plane (serve-nginx). This is an
# nginx-COMPAT sidecar consumed in-process by the webserver — stock
# OpenResty/nginx MUST NOT serve SDKWork public domains
# (SDKWORK_WEBSERVER_SPEC §0.1).
#
# The EDGE-placeholders below are replaced by the postinst sed on the host;
# they deliberately avoid the packager's double-underscore vocabulary so
# pack-time rendering cannot consume the installer's sed patterns.

server {
    listen 80;
    listen [::]:80;
    server_name __EDGE_DOMAIN__;

    # ACME HTTP-01 webroot: the certificate worker writes challenges here,
    # and this listener answers them before any certificate exists.
    location /.well-known/acme-challenge/ {
        root __EDGE_DATA_ROOT__/acme-webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __EDGE_DOMAIN__;

    # TLS material swap boundary: the nginx-compat configuration materializes
    # once per process (multi-file configs have no revision watch), so after
    # `active` is relinked to a fresh issue run
    # `systemctl restart sdkwork-webserver-edge`. The postinst seeds a
    # bootstrap self-signed pair (tls-bootstrap/, outside the worker's
    # pruned material root) so :443 opens before the first issuance.
    ssl_certificate __EDGE_DATA_ROOT__/tls-materials/active/fullchain.pem;
    ssl_certificate_key __EDGE_DATA_ROOT__/tls-materials/active/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:__EDGE_INGRESS_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
