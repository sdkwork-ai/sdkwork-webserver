# SDKWork Web Server public edge configuration (production).
# Rendered by the postinst from
# /usr/lib/sdkwork/webserver/share/nginx.production.conf.template and served
# by the gateway's nginx-compat data plane (serve-nginx). This is an
# nginx-COMPAT sidecar consumed in-process by the webserver — stock
# OpenResty/nginx MUST NOT serve SDKWork public domains
# (SDKWORK_WEBSERVER_SPEC §0.1).
#
# The EDGE-placeholders below are replaced by the postinst sed on the host;
# they deliberately avoid the packager's double-underscore vocabulary so
# pack-time rendering cannot consume the installer's sed patterns.

server {
    listen 80;
    listen [::]:80;
    server_name __EDGE_DOMAIN__;

    # ACME HTTP-01 webroot: the certificate worker writes challenges here,
    # and this listener answers them before any certificate exists.
    location /.well-known/acme-challenge/ {
        root __EDGE_DATA_ROOT__/acme-webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __EDGE_DOMAIN__;

    # Canonical ACME live layout (W25): the certificate worker exports every
    # issued/renewed material in place under
    # /etc/sdkwork/certs/letsencrypt/<cert-name>/, so the operator signs the
    # domain-named certificate and the edge reads the refreshed files on its
    # next reload - no manual copy step. The postinst seeds a bootstrap
    # self-signed pair at this exact path on cold start so :443 opens before
    # the first issuance.
    ssl_certificate __EDGE_LIVE_ROOT__/__EDGE_DOMAIN__/fullchain.pem;
    ssl_certificate_key __EDGE_LIVE_ROOT__/__EDGE_DOMAIN__/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:__EDGE_INGRESS_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
