#!/bin/bash
# postrm for the sdkwork-webserver package (environment: __ENVIRONMENT__).
# Disables services and cleans the test hosts entry on remove/purge.
# Runtime data under /var/lib/sdkwork/webserver is preserved on remove and
# removed on purge.

set -euo pipefail

SERVICE_NAME="__SERVICE_NAME__"
DOMAIN="__DOMAIN__"
ENVIRONMENT="__ENVIRONMENT__"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  systemctl disable "${SERVICE_NAME}" >/dev/null 2>&1 || true
  systemctl disable sdkwork-webserver-certificate-worker >/dev/null 2>&1 || true
  if [ "${ENVIRONMENT}" = "test" ]; then
    if [ -f /etc/hosts ]; then
      sed -i "/^127\.0\.0\.1[[:space:]]\+${DOMAIN}\$/d" /etc/hosts || true
    fi
  fi
  if [ -f /etc/nginx/sites-enabled/sdkwork-webserver ]; then
    rm -f /etc/nginx/sites-enabled/sdkwork-webserver || true
  fi
  if [ -f /etc/nginx/sites-available/sdkwork-webserver ]; then
    rm -f /etc/nginx/sites-available/sdkwork-webserver || true
  fi
fi

if [ "$1" = "purge" ]; then
  rm -rf /etc/sdkwork/webserver /var/lib/sdkwork/webserver \
    /var/log/sdkwork/webserver /var/cache/sdkwork/webserver \
    /run/sdkwork/webserver || true
fi

exit 0
