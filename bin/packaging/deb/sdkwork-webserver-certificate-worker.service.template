[Unit]
Description=SDKWork Web Server certificate worker (__ENVIRONMENT__)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sdkwork
Group=sdkwork
# The typed runtime configuration (/etc/sdkwork/webserver/config.toml)
# is loaded by the binary at startup; secret material is referenced by file
# path inside the TOML. Environment-only secrets (the keyset cursor HMAC key
# is read from the process environment by the repository runtime) are carried
# by the 0600 runtime.env file the installer provisions next to the other
# secrets.
EnvironmentFile=/etc/sdkwork/webserver/secrets/runtime.env
ExecStart=/usr/lib/sdkwork/webserver/bin/sdkwork-webserver-certificate-worker
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The deploy sandbox (drive App API local-projects volume) materializes
# under /opt/deploy (SDKWORK_DEPLOY_SANDBOX_ROOT default), mirroring the
# container deployment's rw overlay on the same tree.
ReadWritePaths=/var/lib/sdkwork/webserver /run/sdkwork/webserver /opt/deploy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
