{
  "schemaVersion": 2,
  "kind": "sdkwork.database.module",
  "databaseRole": "authoritative-server",
  "moduleId": "webserver",
  "serviceCode": "WEB",
  "displayName": "WebServer Database",
  "owner": "web-platform",
  "engines": [
    "postgres"
  ],
  "defaultEngine": "postgres",
  "tablePrefix": "webserver_",
  "baselineAnchorTable": "webserver_site",
  "contractVersion": "1.6.0",
  "baselineStrategy": "baseline-plus-migrations",
  "modules": [],
  "lifecycle": {
    "autoMigrate": false,
    "seedOnBoot": false,
    "defaultSeedLocale": "zh-CN",
    "defaultSeedProfile": "standard",
    "supportedSeedLocales": [
      "zh-CN",
      "en-US"
    ],
    "activeSeedLocales": [
      "zh-CN",
      "en-US"
    ],
    "driftCheckIntervalSec": 60
  },
  "paths": {
    "contract": "contract/schema.yaml",
    "migrations": "migrations",
    "seeds": "seeds",
    "driftPolicy": "drift/policy.yaml"
  },
  "spi": {
    "provider": "default",
    "hooks": []
  }
}
