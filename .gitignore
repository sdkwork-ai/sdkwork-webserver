# SDKWork local-only and generated artifacts
.env
.env.*
!.env.example
!.env.*.example
**/build/
*.log
.DS_Store
Thumbs.db

# ZCode CLI local session metadata (never committed)
.zcode/

# SDKWork local ops/debug scratch (never committed). Default-deny: everything under
# .sdkwork/ is untracked except the tracked metadata skeleton re-included below.
# Without this, nested scratch (e.g. .sdkwork/audit/*.sh) leaks into the repo and the
# script-placement gate rightly flags it (MODULE_BIN_SPEC §2.1).
/.sdkwork/*
!/.sdkwork/.gitignore
!/.sdkwork/README.md
!/.sdkwork/hosts.wsl.sdkwork
!/.sdkwork/skills/
!/.sdkwork/plugins/

# Added during safe-commit pass: exclude runtime hot-reload env scratch
.sdkwork/runtime-env*.json

# Local artifacts and build output (do not commit)
node_modules.bak.*/
_tmp_*
sdks/*/*/package-lock.json

# Local cargo verification target dir (mirrors target/)
target-verify/
**/target-verify/

# Docker runtime materialized state (entrypoint-generated)
deployments/docker/state/

# Generated SDK output (regenerated locally, never committed)
sdks/**/generated/
