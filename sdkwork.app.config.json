  "release": {
    "currentVersion": "0.1.0",
    "defaultChannel": "BETA",
    "latest": {
      "BETA": "0.1.0"
    },
    "notes": [
      {
        "version": "0.1.0",
        "channel": "BETA",
        "current": true,
        "summary": "Pre-release SDKWork standards alignment baseline; Ubuntu .deb and RHEL .rpm installers (test/production) built and verified on Ubuntu 22.04.",
        "packageIds": [
          "linux-rhel-x64-standalone-server-rpm",
          "linux-rhel-x64-standalone-test-server-rpm",
          "linux-ubuntu-x64-standalone-server-deb",
          "linux-ubuntu-x64-standalone-test-server-deb",
          "linux-x64-standalone-server-tar-gz",
          "linux-arm64-standalone-server-tar-gz"
