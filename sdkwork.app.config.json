  "release": {
    "currentVersion": "0.1.9",
    "defaultChannel": "BETA",
    "latest": {
      "BETA": "0.1.9"
    },
    "notes": [
      {
        "version": "0.1.9",
        "channel": "BETA",
        "current": true,
        "summary": "First published release off this baseline. Every prior Package Application run had failed before reaching the publish stage, so no GitHub release existed yet. Two real defects were fixed. (1) The packaging pipeline could not compile its dependency closure: the generated Rust SDK under sdkwork-drive declared 91 model modules in models/mod.rs with no corresponding source file (rustc E0583), so every platform job died in the shared cargo build and no artifact was ever produced. sdkwork-drive main now carries the committed generated sources, and the workspace compiles clean from a cold target directory. (2) The external dependency contract is now explicit: sdkwork.workflow.json pins all 17 sibling repositories to their main branch, with the local checkout resolved by relative path and the release build resolved by git repository ref, so a packaging run is reproducible from the dependency repositories main instead of from whatever a runner happened to have cached.  Installer configuration stays operator-owned at install time: /etc/sdkwork/webserver/config.toml carries the ingress bind, the PostgreSQL host/port/name/schema/user, and the optional Redis resolver-cache layer, and no credential is ever baked into the package -- database and encryption secrets are generated on first install into 0600 files under /etc/sdkwork/webserver/secrets and referenced by path only. Ubuntu and RHEL installers ship for both the test and production environments, alongside the x64 and arm64 server archives. This changelog describes 0.1.9 only.",
        "packageIds": [
          "linux-x64-standalone-server-tar-gz",
          "linux-arm64-standalone-server-tar-gz",
          "linux-ubuntu-x64-standalone-server-deb",
          "linux-ubuntu-x64-standalone-server-test-deb",
          "linux-rhel-x64-standalone-server-rpm",
          "linux-rhel-x64-standalone-server-test-rpm"
        ]
      }
    ]
  },
