{
  "schemaVersion": 1,
  "kind": "sdkwork.component-deployment",
  "application": "sdkwork-webserver-mini-program",
  "parentDeploymentConfig": "../../../etc/sdkwork.deployment.config.json",
  "parentTopologySpec": "../../../specs/topology.spec.json",
  "runtimeTarget": "mini-program",
  "materialization": {
    "authority": "../../../etc/sdkwork.deployment.config.json",
    "command": "node scripts/build-runtime.mjs",
    "format": "mini-program-json",
    "inputPattern": "config/mini-program/runtime-env.{deploymentProfile}.{environment}.json",
    "outputPattern": "src/runtime/",
    "checkMode": "--check",
    "profiles": [
      "standalone.development",
      "standalone.test",
      "standalone.staging",
      "standalone.demo",
      "standalone.production"
    ]
  }
}
