# SDKWork Web Server standalone gateway installer (environment: __ENVIRONMENT__).
# Layout follows RUNTIME_DIRECTORY_SPEC.md section 4.1 and PACKAGING_SPEC.md
# section 5.5 (the .deb/.rpm installer layout matrix).

%global _rpmname __RPM_NAME__

Name:           __RPM_NAME__
Version:        __VERSION__
Release:        1
Summary:        SDKWork Web Server standalone gateway installer (__ENVIRONMENT__ environment)
License:        AGPL-3.0-or-later
URL:            https://sdkwork.com
Source0:        sdkwork-webserver-linux-x64-standalone-server-__VERSION__.tar.gz
__PC_SOURCE1__
Requires:       postgresql-server
Requires:       openssl
Requires:       ca-certificates
__NGINX_REQUIRES__Conflicts:      __CONFLICTS__
BuildArch:      x86_64

%description
SDKWork standards-aligned HTTP web server control plane and immutable
static-site/Wiki delivery data plane.

Installs the standalone gateway on __INGRESS_BIND__ bound to __DOMAIN__ with an
auto-initialized PostgreSQL database, typed TOML runtime configuration
(/etc/sdkwork/webserver/config.toml), systemd service, and runtime
directories per RUNTIME_DIRECTORY_SPEC section 4.1.

%prep
%setup -q -n sdkwork-webserver

%build
# Pre-compiled release binaries; nothing to build.

%install
rm -rf %{buildroot}
install -d -m 0755 %{buildroot}/usr/lib/sdkwork/webserver/bin
install -m 0755 bin/sdkwork-api-webserver-standalone-gateway \
  %{buildroot}/usr/lib/sdkwork/webserver/bin/
install -m 0755 bin/sdkwork-webserver-website-delivery-edge-runtime \
  %{buildroot}/usr/lib/sdkwork/webserver/bin/
install -m 0755 bin/sdkwork-web-node-daemon \
  %{buildroot}/usr/lib/sdkwork/webserver/bin/
install -m 0755 bin/sdkwork-web-agent \
  %{buildroot}/usr/lib/sdkwork/webserver/bin/
install -m 0755 bin/sdkwork-webserver-certificate-worker \
  %{buildroot}/usr/lib/sdkwork/webserver/bin/
install -m 0644 sdkwork.app.config.json package.manifest.json \
  %{buildroot}/usr/lib/sdkwork/webserver/
# Service-local runtime inputs (database contract, specs) stay under the
# application root; IAM/Drive module trees are runtime-mutated (registry
# materialization lock files) so they install under the writable data root.
cp -a database %{buildroot}/usr/lib/sdkwork/webserver/database
cp -a specs %{buildroot}/usr/lib/sdkwork/webserver/specs
install -d -m 0755 %{buildroot}/var/lib/sdkwork/webserver
cp -a share/sdkwork/iam %{buildroot}/var/lib/sdkwork/webserver/iam
cp -a share/sdkwork/drive %{buildroot}/var/lib/sdkwork/webserver/drive
cp -a share/sdkwork/deploy %{buildroot}/var/lib/sdkwork/webserver/deploy
cp -a share/sdkwork/webstore %{buildroot}/var/lib/sdkwork/webserver/webstore
if [ -d share/sdkwork/skills ]; then
  cp -a share/sdkwork/skills %{buildroot}/var/lib/sdkwork/webserver/skills
else
  install -d -m 0755 %{buildroot}/var/lib/sdkwork/webserver/skills
fi
if [ -d share/sdkwork/mcp ]; then
  cp -a share/sdkwork/mcp %{buildroot}/var/lib/sdkwork/webserver/mcp
else
  install -d -m 0755 %{buildroot}/var/lib/sdkwork/webserver/mcp
fi
install -d -m 0755 %{buildroot}/usr/share/sdkwork/webserver/web
cp -a share/sdkwork/webserver-pc %{buildroot}/usr/share/sdkwork/webserver/web/pc
cp -a share/sdkwork/webserver-h5 %{buildroot}/usr/share/sdkwork/webserver/web/h5
cp -a share/sdkwork/webserver-static %{buildroot}/usr/share/sdkwork/webserver/web/static
install -d -m 0755 %{buildroot}/usr/share/doc/sdkwork/webserver
cp -a etc/examples %{buildroot}/usr/share/doc/sdkwork/webserver/examples
install -d -m 0755 %{buildroot}/usr/lib/systemd/system
install -m 0644 %{_sourcedir}/__SERVICE_NAME__.service \
  %{buildroot}/usr/lib/systemd/system/__SERVICE_NAME__.service
__CERT_WORKER_UNIT__
install -d -m 0755 %{buildroot}/usr/share/sdkwork/webserver
__PC_RUNTIME_ENV_OVERRIDE__

%files
/usr/lib/sdkwork/webserver
/var/lib/sdkwork/webserver/iam
/var/lib/sdkwork/webserver/drive
/var/lib/sdkwork/webserver/deploy
/var/lib/sdkwork/webserver/webstore
/var/lib/sdkwork/webserver/skills
/var/lib/sdkwork/webserver/mcp
/usr/share/sdkwork/webserver
/usr/share/doc/sdkwork/webserver
/usr/lib/systemd/system/__SERVICE_NAME__.service
__CERT_WORKER_FILE__

%post -p /bin/bash
# %post (environment: __ENVIRONMENT__). Follows PACKAGING_SPEC.md section 5.5
# and RUNTIME_DIRECTORY_SPEC.md section 4.1: configures the runtime layout and
# service registration only; credentials are generated into 0600 secret files
# and referenced by path from the TOML runtime config, never inlined.
set -euo pipefail

ENVIRONMENT="__ENVIRONMENT__"
DOMAIN="__DOMAIN__"
DB_NAME="__DB_NAME__"
DB_USER="__DB_USER__"
SERVICE_NAME="__SERVICE_NAME__"
VERSION="__VERSION__"
GATEWAY_BINARY="sdkwork-api-webserver-standalone-gateway"

INSTALL_ROOT=/usr/lib/sdkwork/webserver
CONFIG_ROOT=/etc/sdkwork/webserver
DATA_ROOT=/var/lib/sdkwork/webserver
LOG_ROOT=/var/log/sdkwork/webserver
CACHE_ROOT=/var/cache/sdkwork/webserver
RUN_ROOT=/run/sdkwork/webserver
DB_SECRET_FILE="${CONFIG_ROOT}/secrets/database.secret"
RUNTIME_CONFIG_FILE="${CONFIG_ROOT}/config.toml"

log() { echo "[sdkwork-webserver-%post] $*"; }

# 1. Dedicated non-root service identity.
if ! id sdkwork >/dev/null 2>&1; then
  useradd --system --no-create-home --home-dir "${DATA_ROOT}" --shell /usr/sbin/nologin sdkwork
fi

# 2. Runtime directories (RUNTIME_DIRECTORY_SPEC section 4.1 ownership).
install -d -o root -g sdkwork -m 0750 "${CONFIG_ROOT}"
install -d -o sdkwork -g sdkwork -m 0750 \
  "${CONFIG_ROOT}/secrets" \
  "${DATA_ROOT}" "${LOG_ROOT}" "${CACHE_ROOT}" "${RUN_ROOT}"
install -d -o sdkwork -g sdkwork -m 0750 \
  "${DATA_ROOT}/acme-webroot" "${DATA_ROOT}/acme-accounts" "${DATA_ROOT}/tls-materials"
chown -R sdkwork:sdkwork \
  "${DATA_ROOT}/iam" "${DATA_ROOT}/drive" "${DATA_ROOT}/deploy" \
  "${DATA_ROOT}/webstore" "${DATA_ROOT}/skills" "${DATA_ROOT}/mcp" 2>/dev/null || true

# 3. Start PostgreSQL and wait for readiness (RHEL: systemd-managed cluster).
#    The Web Server database contract requires PostgreSQL 16+ (RHEL default
#    modules may ship older versions; enable the postgresql:16 module or the
#    pgdg repository before installing this package).
if ! pg_isready -q 2>/dev/null; then
  systemctl start postgresql >/dev/null 2>&1 || true
  for _attempt in $(seq 1 60); do
    if pg_isready -q 2>/dev/null; then break; fi
    sleep 1
  done
fi
if ! pg_isready -q 2>/dev/null; then
  log "PostgreSQL is not reachable; refusing to continue"
  exit 1
fi
PG_VERSION_MAJOR="$(runuser -u postgres -- psql -tAc 'SHOW server_version_num' 2>/dev/null || true | tr -d ' \r\n')"
if [ -z "${PG_VERSION_MAJOR}" ] || [ "${PG_VERSION_MAJOR}" -lt 160000 ]; then
  log "PostgreSQL 16+ is required (found $(runuser -u postgres -- psql -tAc 'SHOW server_version' 2>/dev/null || true | tr -d ' \r\n')); enable the postgresql:16 module or install PostgreSQL 16+ first"
  exit 1
fi

# 4. Create the environment-specific role, database, and schema with a fresh
#    random password stored only in the workspace database secret file (0600).
DB_PASSWORD="$(openssl rand -hex 24)"
if [ -s "${DB_SECRET_FILE}" ]; then
  DB_PASSWORD="$(tr -d '\r\n' < "${DB_SECRET_FILE}")"
fi
if ! runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${DB_USER}'" | grep -q 1; then
  printf "CREATE ROLE \"%s\" LOGIN PASSWORD '%s';\n" "${DB_USER}" "${DB_PASSWORD}" \
    | runuser -u postgres -- psql -v ON_ERROR_STOP=1 -q >/dev/null
else
  printf "ALTER ROLE \"%s\" WITH LOGIN PASSWORD '%s';\n" "${DB_USER}" "${DB_PASSWORD}" \
    | runuser -u postgres -- psql -v ON_ERROR_STOP=1 -q >/dev/null
fi
if ! runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname = '${DB_NAME}'" | grep -q 1; then
  runuser -u postgres -- createdb -O "${DB_USER}" "${DB_NAME}"
fi
printf 'CREATE SCHEMA IF NOT EXISTS "%s" AUTHORIZATION "%s";\n' "${DB_NAME}" "${DB_USER}" \
  | runuser -u postgres -- psql -d "${DB_NAME}" -v ON_ERROR_STOP=1 -q >/dev/null

install -o sdkwork -g sdkwork -m 0600 /dev/null "${DB_SECRET_FILE}"
printf '%s' "${DB_PASSWORD}" > "${DB_SECRET_FILE}"

# 5. Encryption master keys and Internal API ingress tokens (0600).
for secret_name in encryption-key deploy-encryption-key \
  web-internal-api-ingress-token drive-internal-api-ingress-token knowledgebase-internal-api-ingress-token; do
  secret_file="${CONFIG_ROOT}/secrets/${secret_name}"
  if [ ! -s "${secret_file}" ]; then
    printf '%s' "$(openssl rand -hex 32)" > "${secret_file}"
    chown sdkwork:sdkwork "${secret_file}"
    chmod 0600 "${secret_file}"
  fi
done

# 5b. Credential-entry bootstrap Access-Token (0600, sdkwork-owned) for the
#     PC login page. The test environment uses a locally generated unsigned
#     fixture JWT (`@sdkwork/iam-credential-entry` dev-bootstrap shape,
#     claims per sdkwork.app.config.json backend identity); the gateway
#     injects it into the served index.html. Production MUST provision this
#     token from a private secret source (iam-credential-entry contract) and
#     is intentionally left unset by the installer.
if [ "${ENVIRONMENT}" = "test" ]; then
  BOOTSTRAP_TOKEN_FILE="${CONFIG_ROOT}/secrets/credential-entry-bootstrap-access-token"
  if [ ! -s "${BOOTSTRAP_TOKEN_FILE}" ]; then
    b64url() { printf '%s' "$1" | base64 -w0 | tr '+/' '-_' | tr -d '='; }
    BOOTSTRAP_HEADER='{"alg":"none","typ":"JWT"}'
    BOOTSTRAP_EXPIRES="$(( $(date +%s) + 86400 ))"
    BOOTSTRAP_PAYLOAD="{\"token_version\":1,\"token_type\":\"access\",\"app_id\":\"sdkwork-web\",\"deployment_mode\":\"local\",\"environment\":\"test\",\"exp\":${BOOTSTRAP_EXPIRES},\"login_scope\":\"TENANT\",\"organization_id\":\"0\",\"permission_scope\":[],\"runtime_target\":\"browser\",\"session_id\":\"bootstrap-local-test\",\"tenant_id\":\"100001\",\"user_id\":\"0\"}"
    printf '%s.%s.%s' "$(b64url "${BOOTSTRAP_HEADER}")" "$(b64url "${BOOTSTRAP_PAYLOAD}")" "signature" > "${BOOTSTRAP_TOKEN_FILE}"
    chown sdkwork:sdkwork "${BOOTSTRAP_TOKEN_FILE}"
    chmod 0600 "${BOOTSTRAP_TOKEN_FILE}"
  fi
fi

# 6. Typed runtime configuration (RUNTIME_DIRECTORY_SPEC section 4.1); secret
#    material is referenced by file path only.
cat > "${RUNTIME_CONFIG_FILE}" <<EOF
# Generated by ${SERVICE_NAME} post (version ${VERSION}, environment ${ENVIRONMENT}).
[profile]
deployment_profile = "standalone"
environment = "${ENVIRONMENT}"
profile_id = "standalone.${ENVIRONMENT}"
node_id = 0

[ingress]
bind = "__INGRESS_BIND__"
management_expose_allowed = true
data_plane_operations_bind = "127.0.0.1:3901"
public_http_url = "__PUBLIC_URL__"
app_http_url = "__PUBLIC_URL__"
backend_http_url = "__PUBLIC_URL__"
cors_allowed_origins = ["__PUBLIC_URL__"]

[app_roots]
app_root = "${INSTALL_ROOT}"
iam_app_root = "${DATA_ROOT}/iam"
drive_app_root = "${DATA_ROOT}/drive"
deploy_app_root = "${DATA_ROOT}/deploy"
web_store_app_root = "${DATA_ROOT}/webstore"
pc_static_root = "/usr/share/sdkwork/webserver/web/pc"
h5_static_root = "/usr/share/sdkwork/webserver/web/h5"
static_fallback_root = "/usr/share/sdkwork/webserver/web/static"
tablet_surface = "pc"
# skills/mcp: SDKWORK_SKILLS_APP_ROOT / SDKWORK_MCP_APP_ROOT (ENV), or TOML
# skills_app_root / mcp_app_root when the packaged gateway binary accepts them.

[deploy]
deployment_profile = "standalone"
environment = "${ENVIRONMENT}"
profile_id = "standalone.${ENVIRONMENT}"
use_memory_drive = false
use_memory_content_provider = false
drive_facade_url = "__INTERNAL_API_URL__"
drive_internal_api_url = "__INTERNAL_API_URL__"
drive_internal_api_ingress_token_file = "${CONFIG_ROOT}/secrets/drive-internal-api-ingress-token"
knowledgebase_internal_api_url = "__INTERNAL_API_URL__"
knowledgebase_internal_api_ingress_token_file = "${CONFIG_ROOT}/secrets/knowledgebase-internal-api-ingress-token"
web_internal_api_url = "__INTERNAL_API_URL__"
web_internal_api_ingress_token_file = "${CONFIG_ROOT}/secrets/web-internal-api-ingress-token"
runtime_assignment_worker_id = "deploy-worker-0"

[database]
engine = "postgresql"
host = "127.0.0.1"
port = 5432
name = "${DB_NAME}"
schema = "${DB_NAME}"
schema_fallback_public = false
username = "${DB_USER}"
password_file = "${DB_SECRET_FILE}"
ssl_mode = "disable"
max_connections = 10
auto_migrate = true

[secrets]
encryption_key_file = "${CONFIG_ROOT}/secrets/encryption-key"
deploy_encryption_key_file = "${CONFIG_ROOT}/secrets/deploy-encryption-key"
credential_entry_bootstrap_access_token_file = "${CONFIG_ROOT}/secrets/credential-entry-bootstrap-access-token"

[acme]
profile = "__ACME_PROFILE__"
directory_url = "__ACME_DIRECTORY_URL__"
contact_email = "admin@localhost"
webroot = "${DATA_ROOT}/acme-webroot"
account_root = "${DATA_ROOT}/acme-accounts"
renew_before_days = 30
worker_id = "certificate-worker-0"
operation_poll_interval_secs = 5
renew_scan_interval_secs = 3600

[tls]
material_root = "${DATA_ROOT}/tls-materials"
runtime_snapshot_file = "${DATA_ROOT}/tls-materials/tls-runtime.json"
snapshot_alpn = "h2,http/1.1"

[node]
uuid = "standalone-${ENVIRONMENT}-node"

[region]
region_code = "cn"
seed_locale = "zh-CN"
EOF
chown root:sdkwork "${RUNTIME_CONFIG_FILE}"
chmod 0640 "${RUNTIME_CONFIG_FILE}"

# 7. One-time database migration as the service identity (TOML loaded by the
#    binary itself).
if ! runuser -u sdkwork -- "${INSTALL_ROOT}/bin/${GATEWAY_BINARY}" db-migrate; then
  log "database migration failed; service is not started"
  exit 1
fi

# 8. Register and start the gateway service.
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable "${SERVICE_NAME}" >/dev/null 2>&1 || true
systemctl start "${SERVICE_NAME}"

# 9. Test environment: bind the host to the test domain.
if [ "${ENVIRONMENT}" = "test" ]; then
  if ! grep -q "^127.0.0.1[[:space:]]\+${DOMAIN}" /etc/hosts; then
    printf '127.0.0.1 %s\n' "${DOMAIN}" >> /etc/hosts
  fi
fi

# 10. Production environment: ACME webroot challenge server (nginx :80) and
#     HTTPS reverse proxy (:443 -> 127.0.0.1:__INGRESS_PORT__). RHEL nginx includes
#     /etc/nginx/conf.d/*.conf.
if [ "${ENVIRONMENT}" = "production" ]; then
  cat > /etc/nginx/conf.d/sdkwork-webserver.conf <<EOF
# Generated by ${SERVICE_NAME} %post. ACME http-01 webroot on :80 and
# HTTPS reverse proxy (:443) to the standalone gateway on 127.0.0.1:__INGRESS_PORT__.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root ${DATA_ROOT}/acme-webroot;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN};

    ssl_certificate ${DATA_ROOT}/tls-materials/active/fullchain.pem;
    ssl_certificate_key ${DATA_ROOT}/tls-materials/active/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:__INGRESS_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
  systemctl enable nginx >/dev/null 2>&1 || true
  systemctl restart nginx >/dev/null 2>&1 || true
  systemctl enable sdkwork-webserver-certificate-worker >/dev/null 2>&1 || true
  systemctl start sdkwork-webserver-certificate-worker || true
fi

log "installed environment=${ENVIRONMENT} database=${DB_NAME} ingress=__INGRESS_BIND__ domain=${DOMAIN} config=${RUNTIME_CONFIG_FILE}"
exit 0

%preun -p /bin/bash
# $1 == 1 on upgrade (keep running), $1 == 0 on removal.
if [ "$1" = "0" ]; then
  systemctl stop __SERVICE_NAME__ >/dev/null 2>&1 || true
  systemctl disable __SERVICE_NAME__ >/dev/null 2>&1 || true
  systemctl stop sdkwork-webserver-certificate-worker >/dev/null 2>&1 || true
  systemctl disable sdkwork-webserver-certificate-worker >/dev/null 2>&1 || true
fi
exit 0

%postun -p /bin/bash
# $1 == 0 on removal: clean the test hosts entry and the nginx site.
if [ "$1" = "0" ]; then
  if [ "${__ENVIRONMENT__}" = "test" ] && [ -f /etc/hosts ]; then
    sed -i "/^127\.0\.0\.1[[:space:]]\+__DOMAIN__\$/d" /etc/hosts || true
  fi
  rm -f /etc/nginx/conf.d/sdkwork-webserver.conf || true
fi
exit 0

%changelog
* Sat Aug 08 2026 SDKWork <support@sdkwork.com> - 0.1.0-1
