# SDKWork unified workspace PostgreSQL development profile.
# Copy to .env.postgres for host-local overrides. Do not commit .env.postgres.

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=change-me-local-dev-only
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Required by pnpm db:postgres:init when the role, database, or schema is missing.
SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=change-me-local-dev-only
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

# Optional direct URLs take precedence over the split fields above.
# SDKWORK_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable
# SDKWORK_DATABASE_ADMIN_URL=postgresql://<user>:<admin-password>@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable
