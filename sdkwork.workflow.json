{
  "$schema": "../sdkwork-github-workflow/schemas/sdkwork-workflow.schema.json",
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-web",
    "name": "SDKWork Web Server",
    "repository": "sdkwork-ai/sdkwork-webserver",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-webserver",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEBSERVER_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-deployments",
      "repository": "sdkwork-ai/sdkwork-deployments",
      "refInput": "SDKWORK_DEPLOYMENTS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-knowledgebase",
      "repository": "sdkwork-ai/sdkwork-knowledgebase",
      "refInput": "SDKWORK_KNOWLEDGEBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-mcp",
      "repository": "sdkwork-ai/sdkwork-mcp",
      "refInput": "SDKWORK_MCP_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-skills",
      "repository": "sdkwork-ai/sdkwork-skills",
      "refInput": "SDKWORK_SKILLS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "1.98.0"
  },
  "lifecycle": {
    "preflight": [
      {
        "name": "Install native build dependencies",
        "shell": "pwsh",
        "run": "sudo apt-get update && sudo apt-get install -y cmake clang nasm pkg-config libssl-dev"
      },
      {
        "name": "Ensure rust toolchain on PATH",
        "shell": "bash",
        "run": "set -x; export PATH=\"$HOME/.cargo/bin:/usr/local/cargo/bin:$PATH\"; if ! command -v cargo >/dev/null 2>&1 || [ \"$(cargo --version | awk '{print $2}')\" != \"1.98.0\" ]; then curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.98.0; fi; CARGO_BIN=$(dirname \"$(command -v cargo)\"); echo \"$CARGO_BIN\" >> \"$GITHUB_PATH\"; echo \"cargo bin: $CARGO_BIN\"; cargo --version; rustc --version"
      }
    ],
    "install": [
      {
        "name": "Install locked pnpm workspace",
        "shell": "pwsh",
        "run": "pnpm install --frozen-lockfile"
      }
    ],
    "build": [
      {
        "name": "Build web API server",
        "shell": "bash",
        "run": "export PATH=\"$HOME/.cargo/bin:/usr/local/cargo/bin:$PATH\"; cargo --version; node scripts/build.mjs --release"
      },
      {
        "name": "Build workspace JS library packages (PC/H5 dependency chain)",
        "shell": "pwsh",
        "run": "pnpm --filter \"@sdkwork/webserver-pc^...\" run --if-present build && pnpm --filter \"@sdkwork/webserver-h5^...\" run --if-present build"
      }
    ],
    "package": [
      {
        "name": "Package immutable web server archive",
        "shell": "pwsh",
        "run": "node scripts/webserver-release.mjs package"
      },
      {
        "name": "Package Ubuntu installers (test and production)",
        "shell": "pwsh",
        "run": "node scripts/webserver-deb.mjs package --environment test --architecture x64 && node scripts/webserver-deb.mjs package --environment production --architecture x64"
      },
      {
        "name": "Package RHEL installers (test and production)",
        "shell": "pwsh",
        "run": "node scripts/webserver-rpm.mjs package --environment test --architecture x64 && node scripts/webserver-rpm.mjs package --environment production --architecture x64"
      }
    ],
    "sign": [
      {
        "name": "Sign immutable web server archive with Sigstore",
        "shell": "pwsh",
        "run": "node scripts/webserver-sign.mjs sign"
      }
    ],
    "sbom": [
      {
        "name": "Generate deterministic CycloneDX release SBOM",
        "shell": "pwsh",
        "run": "node scripts/webserver-sbom.mjs generate"
      }
    ],
    "validate": [
      {
        "name": "Validate immutable web server archive",
        "shell": "pwsh",
        "run": "node scripts/webserver-release.mjs validate"
      },
      {
        "name": "Verify immutable web server archive signature",
        "shell": "pwsh",
        "run": "node scripts/webserver-sign.mjs verify"
      },
      {
        "name": "Smoke-test packaged Linux web server",
        "shell": "pwsh",
        "run": "node scripts/webserver-release-smoke.mjs"
      },
      {
        "name": "Validate release SBOM against artifact and Cargo lock",
        "shell": "pwsh",
        "run": "node scripts/webserver-sbom.mjs validate"
      },
      {
        "name": "Validate web standards",
        "shell": "pwsh",
        "run": "pnpm verify"
      },
      {
        "name": "Validate disposable PostgreSQL",
        "shell": "pwsh",
        "run": "pnpm test:postgres:required"
      },
      {
        "name": "Validate database recovery",
        "shell": "pwsh",
        "run": "pnpm test:database:recovery"
      },
      {
        "name": "Validate PostgreSQL streaming failover",
        "shell": "pwsh",
        "run": "pnpm test:postgres:ha"
      },
      {
        "name": "Reject generated contract drift",
        "shell": "pwsh",
        "run": "git diff --exit-code -- ."
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release/sdkwork-webserver-linux-x64-standalone-server-*.tar.gz",
        "dist/release/sdkwork-webserver-linux-x64-standalone-server-*.tar.gz.sha256",
        "dist/release/sdkwork-webserver-linux-x64-standalone-server-*.tar.gz.sigstore.json",
        "dist/release/sdkwork-webserver-linux-x64-standalone-server-*.tar.gz.cdx.json",
        "dist/release/sdkwork-webserver-linux-x64-standalone-server-*.tar.gz.cdx.json.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "linux-arm64-standalone-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "arm64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04-arm",
      "outputGlobs": [
        "dist/release/sdkwork-webserver-linux-arm64-standalone-server-*.tar.gz",
        "dist/release/sdkwork-webserver-linux-arm64-standalone-server-*.tar.gz.sha256",
        "dist/release/sdkwork-webserver-linux-arm64-standalone-server-*.tar.gz.sigstore.json",
        "dist/release/sdkwork-webserver-linux-arm64-standalone-server-*.tar.gz.cdx.json",
        "dist/release/sdkwork-webserver-linux-arm64-standalone-server-*.tar.gz.cdx.json.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "linux-ubuntu-x64-standalone-server-deb",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "deb"
      ],
      "distribution": "ubuntu",
      "environment": "production",
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/installers/sdkwork-webserver_*.deb",
        "dist/installers/sdkwork-webserver_*.deb.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "linux-ubuntu-x64-standalone-server-test-deb",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "deb"
      ],
      "distribution": "ubuntu",
      "environment": "test",
      "variant": "test",
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/installers/sdkwork-webserver-test_*.deb",
        "dist/installers/sdkwork-webserver-test_*.deb.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "linux-rhel-x64-standalone-server-rpm",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "rpm"
      ],
      "distribution": "rhel",
      "environment": "production",
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/installers/sdkwork-webserver-*.rpm",
        "dist/installers/sdkwork-webserver-*.rpm.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "linux-rhel-x64-standalone-server-test-rpm",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "rpm"
      ],
      "distribution": "rhel",
      "environment": "test",
      "variant": "test",
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/installers/sdkwork-webserver-test-*.rpm",
        "dist/installers/sdkwork-webserver-test-*.rpm.sha256"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": true
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": true,
    "retentionDays": 30
  }
}
