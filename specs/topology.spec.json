      "crate": "sdkwork-api-webserver-standalone-gateway",
      "binary": "sdkwork-api-webserver-standalone-gateway"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-webserver-standalone-gateway",
            "binary": "sdkwork-api-webserver-standalone-gateway",
            "script": "_sdkwork:gateway:standalone",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "webserver-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-webserver-pc",
            "bindEnv": "SDKWORK_WEBSERVER_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "browserDeliveries": [
          {
            "id": "webserver-adaptive-web",
            "applicationRoot": "apps/sdkwork-webserver-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "apiSurfaceId": "application.public-ingress",
            "clientProcessId": "webserver-browser",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-webserver-pc",
                "script": "_sdkwork:dev:standalone",
                "defaultPort": 5184,
                "portEnv": "SDKWORK_WEBSERVER_PC_INTERNAL_DEV_PORT"
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-webserver-h5",
                "script": "_sdkwork:dev:standalone",
                "defaultPort": 5185,
                "portEnv": "SDKWORK_WEBSERVER_H5_INTERNAL_DEV_PORT"
              }
            }
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [
          {
            "id": "application.node-daemon",
            "crate": "sdkwork-web-agent",
            "binary": "sdkwork-web-node-daemon",
            "required": true,
            "role": "client"
          },
          {
            "id": "webserver-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-webserver-pc",
            "bindEnv": "SDKWORK_WEBSERVER_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "browserDeliveries": [
          {
            "id": "webserver-adaptive-web",
            "applicationRoot": "apps/sdkwork-webserver-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "apiSurfaceId": "application.public-ingress",
            "clientProcessId": "webserver-browser",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-webserver-pc",
                "script": "_sdkwork:dev:cloud",
                "defaultPort": 5184,
                "portEnv": "SDKWORK_WEBSERVER_PC_INTERNAL_DEV_PORT"
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-webserver-h5",
                "script": "_sdkwork:dev:cloud",
                "defaultPort": 5185,
                "portEnv": "SDKWORK_WEBSERVER_H5_INTERNAL_DEV_PORT"
              }
            }
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "edge.website-delivery",
            "crate": "sdkwork-webserver-website-delivery-edge-runtime",
            "binary": "sdkwork-webserver-website-delivery-edge-runtime",
            "required": true,
            "role": "edge-runtime",
            "script": "_sdkwork:runtime:website-data-plane",
            "decisionRef": "docs/architecture/decisions/ADR-20260721-compiled-website-runtime-descriptor.md"
          }
        ],
        "healthSurfaces": [
          "edge.website-delivery",
          "platform.api-gateway"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-webserver-standalone-gateway",
            "binary": "sdkwork-api-webserver-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "browserDeliveries": [
          {
            "id": "webserver-pc",
            "applicationRoot": "apps/sdkwork-webserver-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "application.public-ingress",
