{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-webserver",
  "applicationCode": "webserver",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "gatewayBind": "127.0.0.1:3800",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_WEBSERVER_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_WEBSERVER_ENVIRONMENT",
    "profileId": "SDKWORK_WEBSERVER_PROFILE_ID",
    "standaloneGatewayBind": "SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND",
    "apiGatewayBaseUrl": "SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_WEBSERVER_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_WEBSERVER_APPLICATION_PUBLIC_HTTP_URL",
      "healthAttempts": 600,
      "healthIntervalMs": 1000,
      "healthTimeoutMs": 2000
    },
    "application.app-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_WEBSERVER_APPLICATION_APP_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_WEBSERVER_APPLICATION_BACKEND_HTTP_URL"
    },
    "edge.website-delivery": {
      "connectivityPlane": "edge",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_WEBSERVER_WEBSITE_DELIVERY_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_WEBSERVER_PLATFORM_API_GATEWAY_HTTP_URL"
    },
    "dependency.deploy-app-api": {
      "connectivityPlane": "dependency",
      "protocols": [
        "http"
      ],
      "runtimeMode": "same-origin",
      "sameOriginAllowed": true,
      "optional": true,
      "apiAuthority": "sdkwork-deployments-app-api",
      "sdkFamily": "deployments-app-sdk",
      "prefix": "/app/v3/api",
      "executableAssemblyExport": "sdkwork_api_deployments_assembly::assemble_domain_certificate_blocks",
      "profileCoverage": [
        "standalone.development",
        "standalone.test",
        "standalone.staging",
        "standalone.production"
      ]
    },
    "dependency.skills-app-api": {
      "connectivityPlane": "dependency",
      "protocols": [
        "http"
      ],
      "runtimeMode": "same-origin",
      "sameOriginAllowed": true,
      "optional": true,
      "apiAuthority": "sdkwork-skills-app-api",
      "sdkFamily": "sdkwork-skills-app-sdk",
      "prefix": "/app/v3/api",
      "executableAssemblyExport": "sdkwork_api_skills_assembly::assemble_app_api_contribution",
      "profileCoverage": [
        "standalone.development",
        "standalone.test",
        "standalone.staging",
        "standalone.production"
      ]
    },
    "dependency.skills-backend-api": {
      "connectivityPlane": "dependency",
      "protocols": [
        "http"
      ],
      "runtimeMode": "same-origin",
      "sameOriginAllowed": true,
      "optional": true,
      "apiAuthority": "sdkwork-skills-backend-api",
      "sdkFamily": "sdkwork-skills-backend-sdk",
      "prefix": "/backend/v3/api",
      "executableAssemblyExport": "sdkwork_api_skills_assembly::assemble_backend_api_contribution",
      "profileCoverage": [
        "standalone.development",
        "standalone.test",
        "standalone.staging",
        "standalone.production"
      ]
    },
    "dependency.mcp-app-api": {
      "connectivityPlane": "dependency",
      "protocols": [
        "http"
      ],
      "runtimeMode": "same-origin",
      "sameOriginAllowed": true,
      "optional": true,
      "apiAuthority": "sdkwork-mcp-app-api",
      "sdkFamily": "sdkwork-mcp-app-sdk",
      "prefix": "/app/v3/api",
      "executableAssemblyExport": "sdkwork_api_mcp_assembly::assemble_app_api_contribution",
      "profileCoverage": [
        "standalone.development",
        "standalone.test",
        "standalone.staging",
        "standalone.production"
      ]
    },
    "dependency.mcp-backend-api": {
      "connectivityPlane": "dependency",
      "protocols": [
        "http"
      ],
      "runtimeMode": "same-origin",
      "sameOriginAllowed": true,
      "optional": true,
      "apiAuthority": "sdkwork-mcp-backend-api",
      "sdkFamily": "sdkwork-mcp-backend-sdk",
      "prefix": "/backend/v3/api",
      "executableAssemblyExport": "sdkwork_api_mcp_assembly::assemble_backend_api_contribution",
      "profileCoverage": [
        "standalone.development",
        "standalone.test",
        "standalone.staging",
        "standalone.production"
      ]
    }
  },
